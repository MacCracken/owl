[package]
name = "owl"
version = "${file:VERSION}"
description = "Observant Watcher of Lines — a file viewer for AGNOS / Cyrius"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/owl"
language = "cyrius"
cyrius = "6.1.14"

[build]
entry = "src/main.cyr"
output = "owl"

# Stdlib footprint chosen for the ROADMAP M0–M4 arc:
#   syscalls/alloc/fmt/io — required baseline
#   str/string/vec        — file content, paths, multi-file list
#   args                  — CLI flag parsing (M0, §3.3)
#   fs                    — reading files by path (M1, §3.2)
#   hashmap               — language + theme tables (M3, §5.1/§5.2)
#   process               — pager spawn (M4, §7)
#   assert                — tests/owl.tcyr
# toml/cyml (config, M7) and any syntax-grammar deps come later.
# vyakarana — tokenizer library for M3b (token-level highlighting).
# 2.2.1 ships 45 bundled grammars; owl currently wires 38 of them
# (matching the 1.9.0 set). The 7 grammars added in the 2.1.x
# window — powershell, crystal, julia (2.1.0); vue, svelte (2.1.1);
# nix (2.1.2); terraform (2.1.3) — are deferred to follow-up owl
# patches per the 1.3.1 catchup-via-patches plan. 2.0.0's API
# break (push-based streaming tokenizer per vyakarana ADR 0017)
# is the load-bearing piece this 1.3.1 cut delivers; 2.0.1's
# rolling-buffer scanner unblocks owl's HIGHLIGHT_MAX lift item
# (parked since M3b) but the lift work is also a catchup patch.
[deps]
stdlib = [
    "syscalls",
    "alloc",
    "fmt",
    "io",
    "fs",
    "str",
    "string",
    "vec",
    "args",
    "hashmap",
    "process",
    "tagged",
    "assert",
]

[deps.vyakarana]
git = "https://github.com/MacCracken/vyakarana.git"
tag = "2.2.1"
modules = ["dist/vyakarana.cyr"]
---
