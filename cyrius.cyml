[package]
name = "owl"
version = "${file:VERSION}"
description = "Observant Watcher of Lines — a file viewer for AGNOS / Cyrius"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/owl"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
output = "owl"


# owl's own viewer surface:
#   syscalls/alloc/fmt/io — required baseline
#   str/string/vec        — file content, paths, multi-file list
#   args                  — CLI flag parsing (M0, §3.3)
#   fs                    — reading files by path (M1, §3.2)
#   hashmap               — language + theme tables (M3, §5.1/§5.2)
#   process               — pager spawn (M4, §7)
#   assert                — tests/owl.tcyr
# vyakarana — tokenizer library for token-level highlighting (46
#   bundled grammars, all wired as of owl 1.4.5).
# sit — VCS change-marker gutter via sit_diff_path (owl 1.4.0;
#   replaced the git fork+execve scaffold).
[deps]
# **This list is now what owl REACHES, not what a bundle mentions.**
# Through 1.4.6 it carried sit's entire transitive footprint (38 entries)
# because `dist/sit.cyr` concatenates sit's full src — including the
# wire/serve/https surface owl never calls — and every symbol it names had
# to resolve at compile time. 1.4.7 moved to `dist/sit-read.cyr`, whose
# fold contains only the read path, so the tail went with it.
#
# Dropped at 1.4.7 (16): slice, fnptr, thread, thread_local, sync, bench,
# net, mmap, dynlib, fdlopen, tls, tls_native, ws, http, sandhi, sakshi.
# Every one was there for sit's network / signing / threading code, none of
# which the read fold contains.
#
# Dropped at 1.4.9 (5): tagged, ct, keccak, bayan, random. 1.4.7 kept the
# last four by hand because the sidecar under-reported sigil's crypto
# follow-throughs (`u256_*` / `ct_select`, `_keccak_*` / `shake256`,
# `random_bytes`). From cyrius 6.6.20, `distlib` output and the folded stdlib
# modules open with a compile-verified `# Requires` block: `lib/sigil.cyr`
# itself includes ct / bayan / random / keccak / tagged, and `cyrius deps`
# materializes them from a clean `lib/` (58 files either way). Verified, not
# assumed: the 17-entry build compiles the identical function set as the
# 22-entry one (3611 unreachable fns / 1,619,537 bytes in both), links with
# only sit's three documented `sign` placeholders, and passes test / smoke /
# fuzz. (6.6.9+ also refuses to emit a binary with a reachable undefined
# function, so the old runtime-SIGILL failure mode is now a build error.)
#
# Re-added at 1.5.1 (1): mmap. From sit 1.7.4 the read fold maps each `.idx` /
# `.pack` read-only (`mmap_file_ro`) instead of reading it onto the never-freed
# heap, and `dist/sit-read.deps` names `mmap` from that tag on.
#
# Procedure on a bump, unchanged: start from the union of the two generated
# sidecars — `dist/sit-read.deps` (11 at sit 1.13.0; it stopped listing the
# alloc / string / io / args / vec leaves once `distlib` attributed them to
# sit's cmdit dep, and owl names those itself) and `dist/vyakarana.deps` (4 at
# 2.10.0) — plus owl's own surface, then add back whatever the link reports
# undefined. Do NOT trust either list alone.
# `thread_local` is NOT needed here (patra's storage slots and sigil's
# crypto bank reach it only from write paths the read fold omits) — it was
# required through 1.4.6 and dropping it is safe only for this fold.
#
#   owl's own viewer surface
#     syscalls/alloc/fmt/io — required baseline
#     str/string/vec        — file content, paths, multi-file list
#     args                  — CLI flag parsing (M0, §3.3)
#     fs                    — reading files by path (M1, §3.2)
#     hashmap               — language + theme tables (M3, §5.1/§5.2)
#     process               — pager spawn (M4, §7)
#   reached through sit-read's diff path
#     chrono/freelist + sankoch (zlib), sigil (hashing),
#     patra (B+tree object store), mmap (read-only pack mappings)
stdlib = [
    "syscalls",
    "alloc",
    "fmt",
    "io",
    "fs",
    "str",
    "string",
    "vec",
    "args",
    "hashmap",
    "process",
    "chrono",
    "freelist",
    "sankoch",
    "sigil",
    "patra",
    "mmap",
]

# Test-only modules (cyrius 6.7.6+): prepended to `cyrius test` / `bench` /
# `fuzz` compiles only, never to the shipped `owl` and never to a `.deps`
# sidecar. `assert` sat in [deps].stdlib through 1.5.3, so it was prepended
# to every surface (DCE dropped it from the release binary, the plain build
# carried it). The test files still `include` what they use themselves, so an
# editor's build-scope resolve sees it too (include-once makes it one copy).
[test]
stdlib = ["assert", "bench", "fnptr"]

[deps.vyakarana]
git = "https://github.com/MacCracken/vyakarana.git"
tag = "2.10.0"
modules = ["dist/vyakarana.cyr"]

# sit — AGNOS-native VCS. owl consumes sit's library export (ADR 0009
# stable surface: sit_repo_open / sit_diff_path / sit_repo_close +
# ann_* accessors) for the VCS change-marker gutter, replacing the
# fork+execve git scaffold (see src/vcs.cyr, owl 1.4.0). dist/sit.cyr is
# a concatenated lib bundle; the diff path transitively reaches sit's
# object-store stack (patra B+tree store, sigil hashing, sankoch
# compression, sakshi) — DCE strips the unused serve/wire/http surface.
#
# **owl consumes the READ profile as of 1.4.7.** `dist/sit-read.cyr` is
# sit's `[lib.read]` fold — the same public API built from only the read
# path, with the signing module and the entire network stack (wire /
# wire_http / serve) cut. sit's own manifest names owl's gutter markers as
# the motivating consumer. 8.6k bundle lines instead of 13.5k, and the
# sidecar `dist/sit-read.deps` lists 16 stdlib leaves instead of 38.
#
# Two things this buys beyond size. The full bundle references stdlib
# globals a consumer's compile doesn't re-export and leaves its wire_ssh /
# async transport symbols unresolved, so owl's link emitted 15 `undefined
# function` warnings that were pure noise — a real one would have hidden in
# them. Those are gone. And `[deps].stdlib` now lists what owl actually
# REACHES rather than what sit's dead code happens to mention.
#
# The read profile keeps reflog / index / commit / merge: they ARE on the
# read path (status honours .gitignore + the index; reading HEAD parses its
# commit object into a tree; ref resolution consults the reflog). Three
# `sign` symbols stay unresolved as dead-path placeholders, referenced only
# by commit's signing path which the read API never calls — that is by
# design upstream, not a missing dep. A fourth, `commit_tree_hex`, has
# dangled since sit 1.7.6 and is NOT in sit's documented list (ADR 0013):
# `cmd_show` (a CLI command compiled into the read fold) calls it, but it is
# defined in `src/history.cyr`, which `[lib.read]` omits. Unreachable from
# owl — the compiler refuses a binary with a reachable undefined fn — so it
# is an upstream bundle-closure gap, not an owl defect.
[deps.sit]
git = "https://github.com/MacCracken/sit.git"
tag = "1.13.0"
modules = ["dist/sit-read.cyr"]

# cmdit — the AGNOS getopt-long library (1.6.0). owl's CLI is parsed by it
# (src/main.cyr, the CLI section) and `--completions` is generated from the
# same flag table. The tag is the one sit pins, so the shared `lib/cmdit.cyr`
# is one file at one version; it was vendored before 1.6.0 as sit's own
# dependency, though nothing in owl included it.
[deps.cmdit]
git = "https://github.com/MacCracken/cmdit.git"
tag = "1.5.0"
modules = ["dist/cmdit.cyr"]
