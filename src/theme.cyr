# src/theme.cyr — bundled themes + ANSI emission (M3a)
#
# Two bundled themes: "dark" (default) and "light". Each theme maps
# decoration zones to 256-color ANSI codes. Token-level palette keys
# (keyword/string/comment/number) are stubbed in as fields for M3b
# so the format doesn't churn when grammars land.
#
# Theme selection resolves to a single active index via theme_select().
# Color output is gated by g_want_color, set during resolve_mode() in
# main.cyr based on --color / NO_COLOR / TTY.

var THEME_COUNT = 2;

# ── Theme table (parallel per-field accessors, keyed by index) ────────

fn theme_name(i) {
    if (i == 0) { return "dark"; }
    if (i == 1) { return "light"; }
    if (i == 2) { return g_user_theme_name; }
    return "dark";
}

fn theme_header_color(i) {
    if (i == 0) { return 45; }   # cyan-ish (256-color index)
    if (i == 1) { return 24; }   # deep blue
    if (i == 2) { return g_user_theme_header; }
    return 7;
}

fn theme_lineno_color(i) {
    if (i == 0) { return 240; }  # dark grey
    if (i == 1) { return 250; }  # light grey
    if (i == 2) { return g_user_theme_lineno; }
    return 7;
}

# ── Token palette (M3b) ────────────────────────────────────────────────
#
# Maps (theme, vyakarana token kind) → 256-color ANSI index. Returns -1
# for "no color" — caller skips ansi_fg.
#
# Dispatch is by `kind_name(kind)` string per vyakarana 1.10.0
# architecture note 004 (theme-palette contract): the 10 kind_name
# strings are the stable identifier across the 1.x line; the integer
# enum is an implementation detail. owl honours the contract by
# resolving kind → name once at the head of the lookup, then comparing
# against the canonical name set ("ident", "keyword", "string",
# "number", "comment", "operator", "punctuation", "whitespace",
# "preprocessor", "error"). If a future vyakarana cut renames any of
# these strings, owl breaks loudly at the streq site instead of
# silently mis-coloring on a re-ordered enum.
#
# Whitespace is always unstyled — the ANSI around empty runs just adds
# noise. Ident and punctuation fall through to the terminal default so
# the file reads like normal text unless the token is semantically
# loud (keyword, string, number, comment, etc.).

fn theme_token_color(theme, kind) {
    var name = kind_name(kind);
    if (theme == 0) {
        # dark
        if (streq(name, "keyword") == 1)      { return 141; }   # purple
        if (streq(name, "string") == 1)       { return 113; }   # green
        if (streq(name, "number") == 1)       { return 215; }   # orange
        if (streq(name, "comment") == 1)      { return 245; }   # grey
        if (streq(name, "operator") == 1)     { return 110; }   # steel blue
        if (streq(name, "preprocessor") == 1) { return 221; }   # yellow
        if (streq(name, "error") == 1)        { return 196; }   # bright red
        return 0 - 1;   # ident / punctuation / whitespace / <invalid>
    }
    if (theme == 1) {
        # light
        if (streq(name, "keyword") == 1)      { return 126; }   # deep magenta
        if (streq(name, "string") == 1)       { return 28;  }   # deep green
        if (streq(name, "number") == 1)       { return 166; }   # deep orange
        if (streq(name, "comment") == 1)      { return 244; }   # mid grey
        if (streq(name, "operator") == 1)     { return 26;  }   # blue
        if (streq(name, "preprocessor") == 1) { return 130; }   # ochre
        if (streq(name, "error") == 1)        { return 124; }   # deep red
        return 0 - 1;
    }
    if (theme == 2) {
        # User theme — the loader at _user_theme_apply_kv keys CYML
        # entries by `token.<name>` strings (already conformant to
        # ADR-004) onto an integer-indexed table for O(1) lookup. As
        # long as the loader and `kind_name` agree on the integer
        # mapping, this stays correct; `kind_is_valid` is the same
        # bounds check vyakarana exports for the public contract.
        if (kind_is_valid(kind) == 0) { return 0 - 1; }
        if (g_user_theme_tokens == 0) { return 0 - 1; }
        return load64(g_user_theme_tokens + kind * 8);
    }
    return 0 - 1;
}

# ── VCS change-marker palette (M6) ────────────────────────────────────
#
# Returns 256-color ANSI index for the vcs.cyr VCS_MARK_* constants.
# Kept separate from theme_token_color so the change gutter stays
# readable even when token highlighting is off (e.g. piped with
# --color=always, no grammar match).
fn theme_change_color(theme, kind) {
    if (theme == 0) {
        # dark
        if (kind == 1) { return 113; }   # ADD — green
        if (kind == 2) { return 215; }   # MOD — orange
        if (kind == 3) { return 167; }   # DEL — red
        return 0 - 1;
    }
    if (theme == 1) {
        # light
        if (kind == 1) { return 28; }    # ADD — deep green
        if (kind == 2) { return 166; }   # MOD — deep orange
        if (kind == 3) { return 124; }   # DEL — deep red
        return 0 - 1;
    }
    if (theme == 2) {
        if (kind < 1) { return 0 - 1; }
        if (kind > 3) { return 0 - 1; }
        if (g_user_theme_vcs == 0) { return 0 - 1; }
        return load64(g_user_theme_vcs + kind * 8);
    }
    return 0 - 1;
}

# ── Public API ─────────────────────────────────────────────────────────

# Look up theme by name. Returns index or -1.
fn theme_index(name) {
    var i = 0;
    while (i < THEME_COUNT) {
        if (streq(theme_name(i), name) == 1) { return i; }
        i = i + 1;
    }
    # 1.1.3 — user theme overlay. Lazy-load $XDG_CONFIG_HOME/owl/themes/<name>.cyml
    # (or $HOME/.config/owl/themes/<name>.cyml). Single slot at THEME_USER_INDEX.
    # The slot already holding `name` answers without touching the disk; any
    # other name is loaded INTO the slot, replacing it (1.5.3). Through 1.5.2
    # a loaded slot refused every other name, so a CLI `--theme=<user theme>`
    # could not override the config's `theme = <another user theme>` —
    # contradicting "CLI overrides config" in --help.
    if (g_user_theme_loaded == 1) {
        if (streq(g_user_theme_name, name) == 1) { return THEME_USER_INDEX; }
    }
    if (_user_theme_load_by_name(name) == 0) { return THEME_USER_INDEX; }
    return 0 - 1;
}

fn print_theme_list() {
    var i = 0;
    while (i < THEME_COUNT) {
        println(theme_name(i));
        i = i + 1;
    }
    return 0;
}

# ── ANSI emission ──────────────────────────────────────────────────────

# Write an integer (0..999) as decimal into buf at offset, return
# number of bytes written.
fn _u16_to_ascii(buf, off, n: i64) {
    # Defensive clamp to the 256-colour range (audit FINDING-008). The
    # only caller is ansi_fg, whose 16-byte buffer is sized for at most
    # three digits; a larger value walked `pi` off the bottom of nbuf AND
    # pushed ansi_fg's write cursor past its own buffer. Colours reach
    # here from a user theme file, so "the caller validated it" is not a
    # bound this function may assume — it enforces its own.
    if (n < 0)   { n = 0; }
    if (n > 255) { n = 255; }
    var nbuf[8];
    var pi: i64 = 7;
    if (n == 0) { store8(&nbuf + pi, 48); pi = pi - 1; }
    while (n > 0) {
        store8(&nbuf + pi, 48 + n % 10);
        pi = pi - 1;
        n = n / 10;
    }
    pi = pi + 1;
    var copied = 0;
    while (pi < 8) {
        store8(buf + off + copied, load8(&nbuf + pi));
        copied = copied + 1;
        pi = pi + 1;
    }
    return copied;
}

# Emit \e[38;5;Nm foreground-color escape on stdout.
# Caller must have verified g_want_color == 1 before calling.
fn ansi_fg(code) {
    var buf[16];
    # "\e[38;5;"
    store8(&buf + 0, 0x1B);
    store8(&buf + 1, 91);   # '['
    store8(&buf + 2, 51);   # '3'
    store8(&buf + 3, 56);   # '8'
    store8(&buf + 4, 59);   # ';'
    store8(&buf + 5, 53);   # '5'
    store8(&buf + 6, 59);   # ';'
    var off = 7;
    off = off + _u16_to_ascii(&buf, off, code);
    store8(&buf + off, 109);  # 'm'
    off = off + 1;
    out_write(&buf, off);
    return 0;
}

# Emit reset escape \e[0m on stdout. Unguarded — callers only call
# this after ansi_fg, so the gate has already been checked.
# Bytes built explicitly. Through cyrius 6.7.10 string literals did not
# parse \x?? escapes, so a literal "\x1b[0m" emitted the characters
# \, x, 1, b, …; 6.7.11+ parses them, but the explicit form is kept so
# the escape bytes stay visible at the one place they are made.
fn ansi_reset() {
    var rbuf[4];
    store8(&rbuf + 0, 0x1B);
    store8(&rbuf + 1, 91);    # '['
    store8(&rbuf + 2, 48);    # '0'
    store8(&rbuf + 3, 109);   # 'm'
    out_write(&rbuf, 4);
    return 0;
}

# ── User themes (1.1.3) ────────────────────────────────────────────────
# Single-slot lazy-loaded theme at index THEME_USER_INDEX. Triggered
# when --theme=<name> is set and <name> doesn't match a bundled theme
# (theme_index falls through to _user_theme_load_by_name). File path:
# $XDG_CONFIG_HOME/owl/themes/<name>.cyml or $HOME/.config/owl/themes/.
#
# Format (flat CYML, ignoring blank lines and `#` comments):
#   header_color = 45
#   lineno_color = 240
#   token.ident       = -1     # -1 = "no color", terminal default
#   token.keyword     = 141
#   token.string      = 113
#   ... (kinds 0..9 per theme_token_color spec)
#   vcs.add = 113
#   vcs.mod = 215
#   vcs.del = 167
#
# Limitations: one user theme is resident at a time. Loading another
# (config `theme = a`, then `--theme=b`) replaces the slot — the later
# load wins, as CLI-over-config requires. User themes do not appear in
# --list-themes (no dir-scanning at startup).
#
# The name is a file name inside the themes directory, never a path: one
# containing `/`, or empty / `.` / `..`, is refused before any path is
# built (1.5.3 — `--theme=../../x` loaded `$XDG_CONFIG_HOME/../../x.cyml`).
# Theme files go through config.cyr's cfg_read_regular: regular files
# only, THEME_FILE_MAX bytes, one warning when longer.

var THEME_USER_INDEX     = 2;
var g_user_theme_loaded  = 0;
var g_user_theme_name    = "user";   # replaced by a heap copy on load
var THEME_FILE_MAX       = 8192;
var g_user_theme_header  = 7;
var g_user_theme_lineno  = 7;
var g_user_theme_tokens  = 0;        # alloc'd: 10 * 8 bytes
var g_user_theme_vcs     = 0;        # alloc'd: 4  * 8 bytes (idx 1=ADD, 2=MOD, 3=DEL)

fn _user_theme_init() {
    if (g_user_theme_tokens == 0) {
        g_user_theme_tokens = alloc(10 * 8);
        g_user_theme_vcs    = alloc(4  * 8);
        # FINDING-011 — every _theme_apply store below indexes these.
        if (g_user_theme_tokens == 0) { return 1; }
        if (g_user_theme_vcs == 0)    { g_user_theme_tokens = 0; return 1; }
        _user_theme_reset();
    }
    return 0;
}

# Return the slot to its pre-load defaults, so a theme loaded over another
# does not inherit the keys the new file leaves out.
fn _user_theme_reset() {
    g_user_theme_header = 7;
    g_user_theme_lineno = 7;
    var i = 0;
    while (i < 10) { store64(g_user_theme_tokens + i * 8, 0 - 1); i = i + 1; }
    i = 0;
    while (i < 4)  { store64(g_user_theme_vcs    + i * 8, 0 - 1); i = i + 1; }
    return 0;
}

fn _theme_keyeq(buf, len, s) {
    var sl = strlen(s);
    if (sl != len) { return 0; }
    return memeq(buf, s, len);
}

# Parse a signed integer of at most three digits from buf[s..e). Returns
# the value, or -99999 when the span is not one.
#
# The digit cap comes BEFORE accumulating (FINDING-010's lesson, as in
# set_tabs): an unbounded run wraps i64, and the wrapped value can land
# back inside the range check — `18446744073709551716` (2^64 + 100) was
# accepted as colour 100 through 1.5.2. Every valid colour fits in three.
fn _theme_parse_int(buf, s, e) {
    if (s >= e) { return 0 - 99999; }
    var sign = 1;
    var p = s;
    if (load8(buf + p) == 45) { sign = 0 - 1; p = p + 1; }
    if (p >= e) { return 0 - 99999; }
    if (e - p > 3) { return 0 - 99999; }
    var v = 0;
    while (p < e) {
        var c = load8(buf + p);
        if (c < 48) { return 0 - 99999; }
        if (c > 57) { return 0 - 99999; }
        v = v * 10 + (c - 48);
        p = p + 1;
    }
    return v * sign;
}

# Apply one parsed line. key span [ks, ke); value span [vs, ve).
# Unknown keys are silently ignored (forward-compat).
# A 256-colour index, or -1 for "no colour". Anything else is a typo or
# a hostile theme file; both are ignored rather than clamped, so a bad
# line behaves exactly like every other bad line here.
fn _theme_color_ok(v) {
    if (v < 0 - 1) { return 0; }
    if (v > 255)   { return 0; }
    return 1;
}

fn _theme_apply(buf, ks, ke, vs, ve) {
    var klen = ke - ks;
    var v = _theme_parse_int(buf, vs, ve);
    if (v == 0 - 99999) { return 0; }   # bad value — ignore line
    # Audit FINDING-008 — every key below is a colour, and every one of
    # them lands in ansi_fg eventually. Validate once, here.
    if (_theme_color_ok(v) == 0) { return 0; }

    # header/lineno reach ansi_fg unguarded (main.cyr never tests them for
    # -1 the way it tests token and vcs colours), so -1 is not meaningful
    # for them — reject it rather than emitting \e[38;5;m.
    if (_theme_keyeq(buf + ks, klen, "header_color") == 1) {
        if (v < 0) { return 0; }
        g_user_theme_header = v;
        return 0;
    }
    if (_theme_keyeq(buf + ks, klen, "lineno_color") == 1) {
        if (v < 0) { return 0; }
        g_user_theme_lineno = v;
        return 0;
    }
    if (_theme_keyeq(buf + ks, klen, "token.ident") == 1)        { store64(g_user_theme_tokens + 0 * 8, v); return 0; }
    if (_theme_keyeq(buf + ks, klen, "token.keyword") == 1)      { store64(g_user_theme_tokens + 1 * 8, v); return 0; }
    if (_theme_keyeq(buf + ks, klen, "token.string") == 1)       { store64(g_user_theme_tokens + 2 * 8, v); return 0; }
    if (_theme_keyeq(buf + ks, klen, "token.number") == 1)       { store64(g_user_theme_tokens + 3 * 8, v); return 0; }
    if (_theme_keyeq(buf + ks, klen, "token.comment") == 1)      { store64(g_user_theme_tokens + 4 * 8, v); return 0; }
    if (_theme_keyeq(buf + ks, klen, "token.operator") == 1)     { store64(g_user_theme_tokens + 5 * 8, v); return 0; }
    if (_theme_keyeq(buf + ks, klen, "token.punctuation") == 1)  { store64(g_user_theme_tokens + 6 * 8, v); return 0; }
    if (_theme_keyeq(buf + ks, klen, "token.whitespace") == 1)   { store64(g_user_theme_tokens + 7 * 8, v); return 0; }
    if (_theme_keyeq(buf + ks, klen, "token.preprocessor") == 1) { store64(g_user_theme_tokens + 8 * 8, v); return 0; }
    if (_theme_keyeq(buf + ks, klen, "token.error") == 1)        { store64(g_user_theme_tokens + 9 * 8, v); return 0; }
    if (_theme_keyeq(buf + ks, klen, "vcs.add") == 1) { store64(g_user_theme_vcs + 1 * 8, v); return 0; }
    if (_theme_keyeq(buf + ks, klen, "vcs.mod") == 1) { store64(g_user_theme_vcs + 2 * 8, v); return 0; }
    if (_theme_keyeq(buf + ks, klen, "vcs.del") == 1) { store64(g_user_theme_vcs + 3 * 8, v); return 0; }
    return 0;
}

fn _theme_is_ws(c) {
    if (c == 32) { return 1; }
    if (c == 9)  { return 1; }
    if (c == 13) { return 1; }
    return 0;
}

# Process one line of the theme file.
fn _theme_parse_line(buf, s, e) {
    while (s < e) {
        if (_theme_is_ws(load8(buf + s)) == 0) { break; }
        s = s + 1;
    }
    while (e > s) {
        if (_theme_is_ws(load8(buf + e - 1)) == 0) { break; }
        e = e - 1;
    }
    if (s >= e) { return 0; }
    if (load8(buf + s) == 35) { return 0; }   # comment

    var eq = s;
    while (eq < e) {
        if (load8(buf + eq) == 61) { break; }
        eq = eq + 1;
    }
    if (eq >= e) { return 0; }   # no '=' — skip

    var ke = eq;
    while (ke > s) {
        if (_theme_is_ws(load8(buf + ke - 1)) == 0) { break; }
        ke = ke - 1;
    }
    if (ke <= s) { return 0; }

    var vs = eq + 1;
    while (vs < e) {
        if (_theme_is_ws(load8(buf + vs)) == 0) { break; }
        vs = vs + 1;
    }
    if (vs >= e) { return 0; }

    _theme_apply(buf, s, ke, vs, e);
    return 0;
}

# Apply theme text buf[0..total) to the slot, resetting it first. Lines
# apply in order, last one wins; `trunc` = the buffer is a prefix of a
# longer file, so its unterminated tail is a fragment and is skipped.
# Caller has run _user_theme_init.
fn _theme_apply_text(buf, total, trunc) {
    _user_theme_reset();
    var ls = 0;
    var i = 0;
    while (i < total) {
        if (load8(buf + i) == 10) {
            _theme_parse_line(buf, ls, i);
            ls = i + 1;
        }
        i = i + 1;
    }
    if (ls < total) {
        if (trunc == 0) { _theme_parse_line(buf, ls, total); }
    }
    return 0;
}

# Record `name` as the slot's name. The copy matters: callers pass
# transient buffers (config.cyr hands over a stack scratch), and through
# 1.5.2 the slot kept the pointer, so a later `--theme=<same name>` read
# a dead stack frame and reported "unknown theme". Returns 0, or 1 when
# the copy cannot be allocated.
fn _user_theme_set_name(name) {
    var nlen = strlen(name);
    var copy = alloc(nlen + 1);
    if (copy == 0) { return 1; }   # FINDING-011
    var k = 0;
    while (k < nlen) { store8(copy + k, load8(name + k)); k = k + 1; }
    store8(copy + nlen, 0);
    g_user_theme_name = copy;
    return 0;
}

# Read the theme file at `path` into the slot as `name`. Returns 0
# success, 1 if the file is missing / not a regular file / unreadable /
# empty — in which case the slot is left exactly as it was.
fn _theme_file_load(path, name) {
    var res[16];
    var buf = cfg_read_regular(path, THEME_FILE_MAX, &res);
    if (buf == 0) { return 1; }
    var total = load64(&res);
    var trunc = load64(&res + 8);
    if (total == 0) { return 1; }

    if (_user_theme_init() != 0) { return 1; }    # FINDING-011
    if (_user_theme_set_name(name) != 0) { return 1; }
    if (trunc == 1) { cfg_warn_truncated(path, THEME_FILE_MAX); }
    _theme_apply_text(buf, total, trunc);
    g_user_theme_loaded = 1;
    return 0;
}

# Is `name` usable as a theme file name? It is joined into
# "<themes dir>/<name>.cyml", so it must be a single path component:
# non-empty, no `/`, not `.` or `..`, and short enough that the joined
# component fits NAME_MAX (255) with its ".cyml".
fn _theme_name_ok(name) {
    var nlen = strlen(name);
    if (nlen == 0) { return 0; }
    if (nlen > 250) { return 0; }
    var k = 0;
    while (k < nlen) {
        if (load8(name + k) == 47) { return 0; }   # '/'
        k = k + 1;
    }
    if (streq(name, ".") == 1)  { return 0; }
    if (streq(name, "..") == 1) { return 0; }
    return 1;
}

# Build "<base><sep>owl/themes/<name>.cyml" path. Returns alloc'd buf.
fn _theme_join_path(base, sep, name) {
    var blen = strlen(base);
    var slen = strlen(sep);
    var middle = "owl/themes/";
    var mlen = strlen(middle);
    var nlen = strlen(name);
    var ext = ".cyml";
    var elen = strlen(ext);
    var total = blen + slen + mlen + nlen + elen + 1;
    var out = alloc(total);
    if (out == 0) { return 0; }   # FINDING-011
    var off = 0;
    var k = 0;
    while (k < blen) { store8(out + off + k, load8(base + k)); k = k + 1; }
    off = off + blen;
    k = 0;
    while (k < slen) { store8(out + off + k, load8(sep + k)); k = k + 1; }
    off = off + slen;
    k = 0;
    while (k < mlen) { store8(out + off + k, load8(middle + k)); k = k + 1; }
    off = off + mlen;
    k = 0;
    while (k < nlen) { store8(out + off + k, load8(name + k)); k = k + 1; }
    off = off + nlen;
    k = 0;
    while (k < elen) { store8(out + off + k, load8(ext + k)); k = k + 1; }
    off = off + elen;
    store8(out + off, 0);
    return out;
}

# Try to load a user theme by name into the slot (replacing whatever it
# held). Returns 0 on success; otherwise 1, with the slot unchanged.
fn _user_theme_load_by_name(name) {
    if (_theme_name_ok(name) == 0) { return 1; }
    var xdg = getenv("XDG_CONFIG_HOME");
    if (xdg != 0) {
        if (load8(xdg) != 0) {
            var p = _theme_join_path(xdg, "/", name);
            if (p != 0) {
                if (_theme_file_load(p, name) == 0) { return 0; }
            }
        }
    }
    var home = getenv("HOME");
    if (home != 0) {
        if (load8(home) != 0) {
            var p = _theme_join_path(home, "/.config/", name);
            if (p != 0) {
                if (_theme_file_load(p, name) == 0) { return 0; }
            }
        }
    }
    return 1;
}
