# owl — main entry point
# Stdlib auto-included via cyrius.cyml

include "lib/vyakarana.cyr"
include "src/escape.cyr"
include "src/out.cyr"
include "src/lang.cyr"
include "src/theme.cyr"
include "src/pager.cyr"
include "src/vcs.cyr"
include "src/config.cyr"

# Keep OWL_VERSION in sync with the VERSION file.
# A M8 CI check will enforce equality; for now, manual.
var OWL_VERSION = "owl 1.5.3";

var BUFSIZE = 65536;

# M3b — cap on file size for token-highlighted rendering. Larger files
# fall back to plain streaming (decorations still render; token-level
# color does not).
#
# Sized at 16 MB since 1.3.6 to match vyakarana 2.0.1's
# `VYK_STREAM_CAP` (the rolling-buffer scanner caps the longest
# in-progress span — block comments, multi-line strings, fenced
# bodies — at 16 MB rather than total input). owl drives the
# streaming feed per-chunk during the read loop so vyakarana's
# scanner state stays bounded by the live span; total input is
# bounded by HIGHLIGHT_MAX because owl still keeps the slurped
# source resident for the byte-by-byte render walk.
#
# Pre-1.3.6 was 128 KB (131072) against a one-shot feed; the bump
# matches the upstream cap and lets long files with normal comment
# density highlight comfortably. Allocation here is bump-allocator
# virtual address space; physical pages commit lazily on write so
# small files don't pay the 16 MB cost in practice.
# One less than vyakarana's VYK_STREAM_CAP (16 MiB): the stream needs
# len + n + 1 bytes, so an input of exactly 16 MiB never fit, and through
# 1.5.2 it was tokenized for its first 64 KiB without a word (audit
# 2026-10-31 FINDING-018). The feed result is also checked now.
var HIGHLIGHT_MAX = 16777215;

# Exit codes per design spec §9
var EXIT_OK       = 0;
var EXIT_PARTIAL  = 1;
var EXIT_USAGE    = 2;
var EXIT_ALL_FAIL = 4;

# ── Mode + theme state (resolved after flag parse) ─────────────────────
var g_decorated = 0;
var g_want_color = 0;

# Flag state set during arg parse. -1 = unset/auto, 0 = off, 1 = on.
var g_flag_numbers  = 0 - 1;
var g_flag_plain    = 0;
var g_flag_color    = 0 - 1;
var g_flag_lang     = 0;           # pointer to --language value, 0 if unset
var g_active_theme  = 0;           # theme index (default 0 = dark)
var g_active_lang   = "plain";     # detected per-file; surfaced for M3b

# M5 — non-printables + whitespace
var g_flag_show_all = 0;           # -A
var g_flag_tabs     = 4;           # --tabs=N; 0 = preserve literal \t
# --wrap is parsed for spec compatibility but doesn't yet insert breaks.
# "never" matches the current behavior (terminal handles visual wrap);
# "character" mode needs a TIOCGWINSZ col count — deferred to M8.
var g_flag_wrap     = 0;           # 0 auto, 1 never, 2 character
var g_flag_verbose  = 0;           # -v / --verbose; expands --version output
# --strip-ansi=auto|always|never. 0=auto (strip whenever the output is
# decorated or coloured), 1=always (strip in undecorated piped output too;
# never in -p, which stays byte-identical to cat), 2=never (alias of -r,
# passthrough). `-r` and `--raw-control-chars` remain the
# canonical opt-out; this flag mirrors `less -R` naming for muscle memory.
var g_flag_strip_ansi = 0;
# --hex / -x: force xxd-style hex dump for any file (binary or text).
# Auto-fallback also fires when a binary file is detected via NUL-byte
# scan, replacing the pre-1.1.3 skip-notice with a useful dump.
var g_flag_hex = 0;

# --format: 0 = text (the viewer), 1 = ndjson (one JSON object per token).
# ndjson is machine output — it forces decorations and colour off and never
# pages (resolve_mode), and it needs a grammar, so it fails loudly rather
# than silently emitting nothing for an undetected language.
var g_flag_format = 0;

# -f / --follow: after rendering the file, keep the fd open and render
# bytes as they are appended, like `tail -f`. Forces paging off (there is
# no end to page to) and highlighting off — see _follow_loop for why the
# tail is deliberately not token-coloured.
var g_flag_follow = 0;
var FOLLOW_POLL_MS = 200;
var FORMAT_TEXT   = 0;
var FORMAT_NDJSON = 1;
# --diff: filter rendered output to lines with VCS markers (ADD/MOD, and
# the DEL anchor lines).
# Forces VCS computation regardless of decoration state. Composes with
# --line-range and --color (just gates emission via _in_range).
var g_flag_diff = 0;
# --line-range=A:B (1-indexed, inclusive). 0 = unset; either or both
# may stay open. Render paths gate byte emission on _in_range();
# once g_line_no passes the end, g_render_done short-circuits the
# read loop in render_fd_loop.
var g_line_range_start = 0;
var g_line_range_end   = 0;
var g_render_done      = 0;
# --wrap=character: terminal column width and current column. cols=0
# means "unset / wrap disabled"; resolved in resolve_mode after the
# TTY check. col tracks bytes emitted on the current visible row and
# resets at every emitted '\n' (file-origin or wrap-inserted).
# 1.1.11 — g_wrap_term_cols caches the resolved terminal width once at
# resolve_mode time; g_wrap_cols (the actual column budget after gutter
# subtraction) is recomputed per file via _recompute_wrap_cols once
# vcs_compute_markers has settled vcs_enabled() for that file. Pre-1.1.11
# always subtracted 11 cols (the VCS-on gutter width) regardless of
# whether the marker cell was rendering, so wrapped content under
# --style=no-changes stopped 2 cols short of the right rule. Now the
# subtraction tracks the actual gutter: 9 cols when vcs_enabled() == 0
# (--style=no-changes), 11 cols when the marker cell is in play.
var g_wrap_cols      = 0;
var g_wrap_term_cols = 0;
var g_wrap_col       = 0;

# 1.1.7 — bat-style header frame. _term_cols result cached per file so
# top/middle/bottom rules render at a consistent width even if the
# window resizes mid-file. g_header_open pairs emit_header with a
# matching emit_footer in the main loop after each rendered file.
var g_term_cols   = 0;
var g_header_open = 0;

# 1.1.8 — wrap-continuation needs to know the in-flight token color
# so the gutter break can reset, draw the continuation prefix in
# lineno color, and restore the prior token color.
# `_render_highlighted_with_tb` writes this on every color
# transition; render_chunk leaves it -1.
var g_render_active_color = 0 - 1;

# Audit FINDING-001: file-origin terminal escapes are stripped from
# the byte stream in decorated/colored output. `-r` / `--raw-control-chars`
# restores the old cat-like passthrough for users who are viewing
# trusted ANSI-colored output (e.g. a captured test log). `-p` already
# does this via a separate code path; `-A` renders ESC visibly as `^[`
# so the classifier is bypassed in that mode too.
var g_flag_raw_controls = 0;

# Escape-stripping state machine — persists across chunks, resets per
# file in render_reset.
#   0  normal
#   1  saw ESC, awaiting introducer
#   2  in CSI, scanning for final byte (0x40–0x7E)
#   3  in OSC/DCS/APC/PM/SOS string, scanning for ST/BEL
#   4  in string body, just saw ESC (next byte might be `\` → ST)

# Streaming render state, reset per input.
var g_line_no       = 1;
var g_at_line_start = 1;

# ── TTY detection ──────────────────────────────────────────────────────

# TTY detection via ioctl(fd, TCGETS). Succeeds only on terminals —
# unlike fstat+S_IFCHR, which also matches /dev/null, /dev/zero, and
# any other character device. (That's the bug that let `owl ... > /dev/null`
# spawn the pager: /dev/null is a char device but not a terminal.)
# TCGETS = 0x5401 on Linux. termios is ~44 bytes; oversizing is free.
fn is_tty(fd) {
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos has no ioctl/termios. The fb console IS an ANSI/SGR-capable tty
    # (fb_console 1.43.2 — the path anuenue's rainbow renders through), so report
    # tty=1 to keep syntax-colour decoration enabled.
    return 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var tbuf[128];
    var r = syscall(SYS_IOCTL, fd, 0x5401, &tbuf);
    if (r < 0) { return 0; }
    return 1;
    #endif
}

# Terminal column count via TIOCGWINSZ on stdout. Returns 0 if not a
# TTY (callers default to 80). winsize = { ws_row, ws_col, ws_xpixel,
# ws_ypixel } as four u16; ws_col is at offset 2.
fn _term_cols() {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;   # no TIOCGWINSZ on agnos — callers default to 80 cols
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var ws[8];
    var r = syscall(SYS_IOCTL, STDOUT, 0x5413, &ws);
    if (r < 0) { return 0; }
    var lo = load8(&ws + 2);
    var hi = load8(&ws + 3);
    return hi * 256 + lo;
    #endif
}

# ── Mode resolution ────────────────────────────────────────────────────

fn resolve_mode() {
    g_decorated = is_tty(STDOUT);

    # NO_COLOR — standard convention, any non-empty value disables color
    # unless --color=always already forced it on.
    var nc = getenv("NO_COLOR");
    if (nc != 0) {
        if (load8(nc) != 0) {
            if (g_flag_color != 1) { g_flag_color = 0; }
        }
    }

    # ndjson is machine output — decorations and colour are meaningless in
    # it, and the escape-strip path never runs because no file byte is
    # written raw (token text is JSON-escaped instead). Handled before -p so
    # `--format=ndjson -p` still emits ndjson rather than silently degrading.
    if (g_flag_format == FORMAT_NDJSON) {
        g_decorated = 0;
        g_want_color = 0;
        return 0;
    }

    # -p overrides everything: no decorations, no color.
    if (g_flag_plain == 1) {
        g_decorated = 0;
        g_want_color = 0;
        return 0;
    }

    # -n lifts decorated on (so numbers render even when piped).
    if (g_flag_numbers == 1) { g_decorated = 1; }

    # Color resolution (independent of decorated — numbers can be on
    # without color when piped, per --color=never).
    if (g_flag_color == 1) { g_want_color = 1; }
    else { if (g_flag_color == 0) { g_want_color = 0; }
           else { g_want_color = is_tty(STDOUT); } }

    # --wrap resolution. 1.1.8: auto (default) wraps when the
    # decorated frame is rendering so content stays inside the bottom
    # rule. character forces wrap regardless of decoration (still
    # useful for scripted fixed-width capture). never is the explicit
    # overflow escape hatch. Plain mode (-p) and piped output without
    # decorations still bypass wrap entirely (cat parity).
    # 1.1.11: terminal width is cached here; the per-file wrap budget
    # (gutter subtraction) is computed by _recompute_wrap_cols, which
    # the render loop calls after vcs_compute_markers settles the
    # gutter width for the current file.
    g_wrap_cols      = 0;
    g_wrap_term_cols = 0;
    var wrap_on = 0;
    if (g_flag_wrap == 2)                          { wrap_on = 1; }
    if (g_flag_wrap == 0) { if (g_decorated == 1) { wrap_on = 1; } }
    if (wrap_on == 1) {
        var c = _term_cols();
        if (c == 0) { c = 80; }
        g_wrap_term_cols = c;
        _recompute_wrap_cols();
    }

    return 0;
}

# 1.1.11 — VCS-aware wrap-budget recompute. Called from resolve_mode
# (initial set) and after every vcs_compute_markers(path) so the wrap
# column budget tracks the actual gutter width: 9 cols when vcs_enabled()
# is 0 (--style=no-changes — lineno + " │ "), 11 cols otherwise (the
# extra 2 cols hold the change-marker cell, which still emits as a
# space outside a repo). No-op when wrap is off (g_wrap_term_cols ==
# 0). When -n is off the gutter subtraction is skipped entirely — wrap
# uses the full terminal width.
fn _recompute_wrap_cols() {
    if (g_wrap_term_cols == 0) { g_wrap_cols = 0; return 0; }
    var c = g_wrap_term_cols;
    if (resolved_show_numbers() == 1) {
        var gutter = 9;
        if (vcs_enabled() == 1) { gutter = 11; }
        if (c > gutter + 2) { c = c - gutter; }
    }
    g_wrap_cols = c;
    return 0;
}

fn resolved_show_numbers() {
    if (g_flag_plain == 1) { return 0; }
    if (g_flag_numbers == 1) { return 1; }
    if (g_flag_numbers == 0) { return 0; }
    if (g_decorated == 1) { return 1; }
    return 0;
}

fn resolved_show_header() {
    if (g_flag_plain == 1) { return 0; }
    if (g_decorated == 1) { return 1; }
    return 0;
}

# ── Decoration rendering ───────────────────────────────────────────────

# 1.1.7 — bat-style three-rule header frame.
#
# Layout when VCS markers are inactive (gutter prefix is 9 cols):
#   "───────┬──────────────────────…\n"
#   "       │ File: <path> (<lang>)\n"
#   "───────┼──────────────────────…\n"
#   "     1 │ <content>\n"
#   …
#   "───────┴──────────────────────…\n"
#
# When VCS markers are active the gutter prefix grows by 2 cols and
# each junction shifts from col 7 → col 9 to track the xe2x94x82
# position. Rules span the full terminal width (TIOCGWINSZ on stdout,
# 80-col fallback when not a TTY — header path itself is gated TTY-only
# via resolved_show_header, so the fallback only kicks in for the rare
# decorated-but-no-winsize case).

fn _gutter_divider_col() {
    if (vcs_enabled() == 1) { return 9; }
    return 7;
}

fn _emit_dashes(n: i64) {
    var i: i64 = 0;
    while (i < n) {
        out_write("─", 3);
        i = i + 1;
    }
    return 0;
}

# Emit one horizontal rule with the given junction glyph at the
# divider column. junction is a 3-byte UTF-8 string ("┬" / "┼" / "┴").
fn _emit_rule(junction) {
    var div_col = _gutter_divider_col();
    var cols    = g_term_cols;
    if (cols <= 0)          { cols = 80; }
    if (cols < div_col + 2) { cols = div_col + 2; }
    if (g_want_color == 1) { ansi_fg(theme_lineno_color(g_active_theme)); }
    _emit_dashes(div_col);
    out_write(junction, 3);
    _emit_dashes(cols - div_col - 1);
    if (g_want_color == 1) { ansi_reset(); }
    out_write("\n", 1);
    return 0;
}

fn emit_header(path) {
    var c = _term_cols();
    if (c <= 0) { c = 80; }
    g_term_cols = c;

    _emit_rule("┬");

    # Header line: blank gutter (no lineno), divider, then "File: …".
    var div_col = _gutter_divider_col();
    if (g_want_color == 1) { ansi_fg(theme_lineno_color(g_active_theme)); }
    var pad = 0;
    while (pad < div_col) {
        out_write(" ", 1);
        pad = pad + 1;
    }
    out_write("│ ", 4);
    if (g_want_color == 1) { ansi_reset(); }

    if (g_want_color == 1) { ansi_fg(theme_header_color(g_active_theme)); }
    out_write("File: ", 6);
    out_write_sanitized(path, strlen(path));   # audit 2026-10-31 FINDING-015
    if (streq(g_active_lang, "plain") == 0) {
        out_write(" (", 2);
        out_write(g_active_lang, strlen(g_active_lang));
        out_write(")", 1);
    }
    if (g_want_color == 1) { ansi_reset(); }
    out_write("\n", 1);

    _emit_rule("┼");

    g_header_open = 1;
    return 0;
}

# Pair for emit_header. Called from main() after each per-file render
# returns so every code path that opened a header (hex, binary auto,
# highlighted, plain stream) gets a matching bottom rule. No-op when
# the header never opened (plain mode, piped without -n, etc.).
fn emit_footer() {
    if (g_header_open == 0) { return 0; }
    # A file without a trailing newline left the cursor mid-line, and the
    # rule was drawn onto its last line (`abc───┴…`).
    if (g_at_line_start == 0) {
        out_write("\n", 1);
        g_at_line_start = 1;
        g_wrap_col = 0;
    }
    _emit_rule("┴");
    g_header_open = 0;
    return 0;
}

# Gutter layout:
#   "     1 " (6-char right-aligned lineno + space)
#   " "       (change-marker cell: '+'/'~'/'-' or ' ', its own color)
#   " │ "     (divider + space, lineno color)
#
# The change-marker cell is only emitted when vcs_enabled() == 1 so
# the gutter stays narrow when --style=no-changes / --no-color or
# when we're outside a repo.
fn emit_lineno(ln: i64) {
    if (_in_range() == 0) { return 0; }
    # Digits right-aligned in at least 6 columns, then a space. The buffer
    # holds any i64 (19 digits). Through 1.5.2 an 8-byte buffer was filled
    # downward from index 5 with no lower bound: from line 1,000,000 each
    # extra digit was stored below the buffer, and the gutter showed the
    # number mod 10^6 (audit 2026-10-31 FINDING-023). A 7+ digit number now
    # prints whole; the gutter is one column wider for those lines.
    var pbuf[32];
    var n = ln;
    var pi: i64 = 23;
    store8(&pbuf + 24, 32);
    if (n <= 0) { store8(&pbuf + pi, 48); pi = pi - 1; }
    while (n > 0) {
        store8(&pbuf + pi, 48 + n % 10);
        pi = pi - 1;
        n = n / 10;
    }
    while (pi > 17) {
        store8(&pbuf + pi, 32);
        pi = pi - 1;
    }

    if (g_want_color == 1) { ansi_fg(theme_lineno_color(g_active_theme)); }
    out_write(&pbuf + pi + 1, 24 - pi);
    if (g_want_color == 1) { ansi_reset(); }

    if (vcs_enabled() == 1) {
        var mk = vcs_mark_for_line(ln);
        if (mk == VCS_MARK_NONE) {
            out_write("  ", 2);
        } else {
            var mcolor = theme_change_color(g_active_theme, mk);
            if (g_want_color == 1) {
                if (mcolor != 0 - 1) { ansi_fg(mcolor); }
            }
            if (mk == VCS_MARK_ADD) { out_write("+", 1); }
            if (mk == VCS_MARK_MOD) { out_write("~", 1); }
            if (mk == VCS_MARK_DEL) { out_write("-", 1); }
            if (g_want_color == 1) {
                if (mcolor != 0 - 1) { ansi_reset(); }
            }
            out_write(" ", 1);
        }
    }

    var dbuf[4];
    store8(&dbuf + 0, 0xE2);
    store8(&dbuf + 1, 0x94);
    store8(&dbuf + 2, 0x82);
    store8(&dbuf + 3, 32);
    if (g_want_color == 1) { ansi_fg(theme_lineno_color(g_active_theme)); }
    out_write(&dbuf, 4);
    if (g_want_color == 1) { ansi_reset(); }
    return 0;
}

# ── Streaming ──────────────────────────────────────────────────────────

# Write up to n bytes from s to stderr, replacing every C0 control
# byte (< 0x20) and DEL (0x7F) with '?'. UTF-8 bytes (>= 0x80) pass
# through so non-ASCII paths stay legible. Audit FINDING-002 — a path
# containing raw ESC would otherwise inject ANSI into whatever reads
# our stderr (log capture, CI output, etc.).
fn eprint_sanitized(s, n) {
    var i = 0;
    while (i < n) {
        var c = load8(s + i);
        if (c < 0x20) {
            eprint("?", 1);
        } else {
            if (c == 0x7F) {
                eprint("?", 1);
            } else {
                eprint(s + i, 1);
            }
        }
        i = i + 1;
    }
    return 0;
}

# Set by report_error, so a caller can tell "failed and said why" from
# "failed silently" (stdin read errors used to exit 4 with no message).
var g_err_reported = 0;
var g_read_errno = 0;      # last negative read(2) result from render_fd_loop

# Text for a negative errno from open(2) / read(2) (Linux numbering, which
# aarch64 shares). Through 1.5.2 every open failure said "No such file or
# directory" — EACCES, ENOTDIR, ELOOP alike — and a directory said "read
# error" (audit 2026-10-31 FINDING-032).
fn _errno_msg(e) {
    if (e == (0 - 2))  { return "No such file or directory"; }
    if (e == (0 - 13)) { return "Permission denied"; }
    if (e == (0 - 20)) { return "Not a directory"; }
    if (e == (0 - 21)) { return "Is a directory"; }
    if (e == (0 - 40)) { return "Too many levels of symbolic links"; }
    if (e == (0 - 36)) { return "File name too long"; }
    if (e == (0 - 6))  { return "No such device or address"; }
    if (e == (0 - 24)) { return "Too many open files"; }
    if (e == (0 - 23)) { return "Too many open files in system"; }
    if (e == (0 - 12)) { return "Cannot allocate memory"; }
    if (e == (0 - 5))  { return "Input/output error"; }
    return "read error";
}

fn report_error(path, reason) {
    g_err_reported = 1;
    out_flush();
    eprint("owl: ", 5);
    eprint_sanitized(path, strlen(path));
    eprint(": ", 2);
    eprint(reason, strlen(reason));
    eprint("\n", 1);
    return 0;
}

# ── Grammar resolution (1.1.2) ─────────────────────────────────────────
# vyakarana's bootstrap loads grammars via the literal relative path
# "grammars/<lang>.cyml" (lib/vyakarana.cyr:1774). That breaks for any
# invocation where the cwd doesn't happen to contain a grammars/
# subdirectory — silently, because grammar_load returns 0 and the
# registry just stays empty, so has_grammar(lang) reports false and
# render_path skips the highlight branch entirely. The user sees plain
# bytes with no error.
#
# Fix: owl resolves grammars/ via /proc/self/exe (binary location)
# before vyakarana's lazy bootstrap fires, pre-loads every grammar
# with an absolute path, and sets _grammars_bootstrapped = 1 so
# vyakarana's relative-path fallback never runs. Tries:
#   1. <exe-dir>/grammars/                       (installed-adjacent)
#   2. <exe-dir>/../grammars/                    (dev: build/owl + ./grammars/)
#   3. cwd-relative via vyakarana's legacy path  (resolved-by 0 on failure)
# Probe is grammars/cyrius.cyml — every owl build has it.

var g_grammars_dir          = 0;   # NUL-term abs path of grammars/, or 0
var g_grammars_dir_resolved = 0;   # cache flag: don't re-resolve

# 1.1.3 — user grammar overlay. Loaded BEFORE bundled in the bootstrap
# so vyakarana's registry_find_by_name (first-match) returns the user
# version when names collide. New language names need a lang.cyr table
# update; the override-only scope here lets a user patch a single
# bundled grammar without that.
var g_user_grammars_dir          = 0;
var g_user_grammars_dir_resolved = 0;

fn _grammar_dir_has_cyrius(dir) {
    # Build "<dir>cyrius.cyml" in a probe buffer, file_open it.
    var dlen = strlen(dir);
    if (dlen + 12 >= 512) { return 0; }
    var probe[512];
    var k = 0;
    while (k < dlen) { store8(&probe + k, load8(dir + k)); k = k + 1; }
    var name = "cyrius.cyml";
    var nlen = strlen(name);
    var j = 0;
    while (j < nlen) { store8(&probe + dlen + j, load8(name + j)); j = j + 1; }
    store8(&probe + dlen + nlen, 0);
    var fd = file_open(&probe, O_RDONLY, 0);
    if (fd < 0) { return 0; }
    file_close(fd);
    return 1;
}

# Build "<base>grammars/" into out (alloc'd). Returns out.
fn _join_grammars(base, base_len) {
    var suffix = "grammars/";
    var slen = strlen(suffix);
    var total = base_len + slen + 1;
    var out = alloc(total);
    if (out == 0) { return 0; }
    var k = 0;
    while (k < base_len) { store8(out + k, load8(base + k)); k = k + 1; }
    var j = 0;
    while (j < slen) { store8(out + base_len + j, load8(suffix + j)); j = j + 1; }
    store8(out + base_len + slen, 0);
    return out;
}

fn _resolve_grammars_dir() {
    if (g_grammars_dir_resolved == 1) { return g_grammars_dir; }
    g_grammars_dir_resolved = 1;

    # readlink /proc/self/exe → absolute binary path. SYS_readlink = 89
    # on Linux x86_64. Returns negative on failure (no /proc, etc.).
    #ifdef CYRIUS_TARGET_AGNOS
    # No readlink / /proc on agnos — use the compiled-in vyakarana grammars
    # (no external grammars dir relative to the binary).
    g_grammars_dir = 0;
    return 0;
    #endif
    var link[512];
    var n = syscall(89, "/proc/self/exe", &link, 511);
    if (n <= 0) { g_grammars_dir = 0; return 0; }
    store8(&link + n, 0);

    # Find last "/" — everything before it (inclusive) is the exe dir.
    var slash = n;
    while (slash > 0) {
        if (load8(&link + slash - 1) == 47) { break; }
        slash = slash - 1;
    }

    # Candidate 1: <exe-dir>/grammars/
    var c1 = _join_grammars(&link, slash);
    if (c1 == 0) { g_grammars_dir = 0; return 0; }
    if (_grammar_dir_has_cyrius(c1) == 1) {
        g_grammars_dir = c1;
        return c1;
    }

    # Candidate 2: <exe-dir>/../grammars/  (covers build/owl + ./grammars/)
    # Strip one trailing path component from the exe dir to get parent.
    if (slash > 1) {
        var parent_end = slash - 1;     # skip trailing "/"
        while (parent_end > 0) {
            if (load8(&link + parent_end - 1) == 47) { break; }
            parent_end = parent_end - 1;
        }
        var c2 = _join_grammars(&link, parent_end);
        if (c2 == 0) { g_grammars_dir = 0; return 0; }
        if (_grammar_dir_has_cyrius(c2) == 1) {
            g_grammars_dir = c2;
            return c2;
        }
    }

    # No exe-relative dir found. Leave g_grammars_dir = 0; caller will
    # let vyakarana fall back to cwd-relative load. That fallback works
    # only when cwd has grammars/ — same as pre-1.1.2 behavior.
    g_grammars_dir = 0;
    return 0;
}

# Longest env-derived directory owl will build a grammar path from. The
# user-overlay dir comes from $XDG_CONFIG_HOME / $HOME, so its length is
# the environment's to choose.
var GRAMMAR_DIR_MAX = 4096;

# "<base><suffix>" in an allocation sized from both; 0 when base is empty,
# longer than GRAMMAR_DIR_MAX, or the alloc fails.
fn _join_dir(base, suffix) {
    var blen = strlen(base);
    if (blen == 0) { return 0; }
    if (blen > GRAMMAR_DIR_MAX) { return 0; }
    var slen = strlen(suffix);
    var out = alloc(blen + slen + 1);
    if (out == 0) { return 0; }
    memcpy(out, base, blen);
    memcpy(out + blen, suffix, slen);
    store8(out + blen + slen, 0);
    return out;
}

# 1 when path names a directory. Opened O_DIRECTORY | O_NONBLOCK, so a FIFO
# or a file at the path neither blocks nor counts. agnos has neither flag
# and no external overlay to probe: report "maybe" and let loads decide.
fn _is_dir(path) {
    #ifdef CYRIUS_TARGET_AGNOS
    return 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var fd = file_open(path, O_RDONLY + O_DIRECTORY + O_NONBLOCK, 0);
    if (fd < 0) { return 0; }
    file_close(fd);
    return 1;
    #endif
}

# Resolve the user grammars dir: $XDG_CONFIG_HOME/owl/grammars/ when XDG is
# set, else $HOME/.config/owl/grammars/. 0 when it is not a directory —
# user grammars are opt-in, and probing 49 files in a dir that does not
# exist cost 49 failed opens on every first highlight.
fn _resolve_user_grammars_dir() {
    if (g_user_grammars_dir_resolved == 1) { return g_user_grammars_dir; }
    g_user_grammars_dir_resolved = 1;
    g_user_grammars_dir = 0;

    var dir = 0;
    var xdg = getenv("XDG_CONFIG_HOME");
    var have_xdg = 0;
    if (xdg != 0) { if (load8(xdg) != 0) { have_xdg = 1; } }
    if (have_xdg == 1) { dir = _join_dir(xdg, "/owl/grammars/"); }
    else {
        var home = getenv("HOME");
        if (home != 0) { dir = _join_dir(home, "/.config/owl/grammars/"); }
    }
    if (dir == 0) { return 0; }
    if (_is_dir(dir) == 0) { return 0; }
    g_user_grammars_dir = dir;
    return dir;
}

# Load "<dir><name>.cyml" into the registry. `path` holds `cap` bytes;
# a path that would not fit is skipped. Through 1.5.2 this copied an
# env-derived dir into a fixed 1024-byte buffer with no check — a heap
# overflow from a long $HOME / $XDG_CONFIG_HOME on any highlighted file
# (audit 2026-10-31 FINDING-017, a sibling of FINDING-007).
fn _owl_load_grammar(dir, path, cap, name) {
    var dlen = strlen(dir);
    var nlen = strlen(name);
    if (dlen + nlen + 6 > cap) { return 0; }
    memcpy(path, dir, dlen);
    memcpy(path + dlen, name, nlen);
    memcpy(path + dlen + nlen, ".cyml", 5);
    store8(path + dlen + nlen + 5, 0);
    var g = grammar_load(path);
    if (g != 0) { registry_add(g); }
    return 0;
}

# Every grammar owl knows, from one list: the language table (1.5.2 wired
# markdown, the one bundled grammar it lacked; 1.5.3 made the table the
# only list, so a grammar cannot again be bundled but unreachable).
fn _owl_load_all(dir, path, cap) {
    var i = 1;   # 0 is "plain"
    while (i < LANG_COUNT) {
        _owl_load_grammar(dir, path, cap, lang_name(i));
        i = i + 1;
    }
    return 0;
}

# Owl-side bootstrap. Pre-loads every bundled grammar via an absolute
# path resolved from /proc/self/exe, then sets vyakarana's
# _grammars_bootstrapped flag so its lazy relative-path bootstrap
# doesn't fire and overwrite the registry with failed loads.
# Idempotent. Cheap on the second call.
fn _owl_bootstrap_grammars() {
    if (_grammars_bootstrapped == 1) { return 0; }
    var dir = _resolve_grammars_dir();
    if (dir == 0) { return 0; }   # let vyakarana's relative path try

    registry_init();
    var udir = _resolve_user_grammars_dir();
    var cap = strlen(dir);
    if (udir != 0) { if (strlen(udir) > cap) { cap = strlen(udir); } }
    cap = cap + 64;               # longest name ("asm_aarch64") + ".cyml" + NUL
    var path = alloc(cap);
    if (path == 0) { return 0; }

    # User overlay first — vyakarana's registry is a vec and find_by_name
    # returns the first match, so a user grammar wins by name.
    if (udir != 0) { _owl_load_all(udir, path, cap); }
    _owl_load_all(dir, path, cap);

    _grammars_bootstrapped = 1;
    return 0;
}

# Wrapper around vyakarana's has_grammar that ensures owl's
# absolute-path bootstrap runs first.
fn _owl_has_grammar(lang) {
    _owl_bootstrap_grammars();
    return has_grammar(lang);
}

# ── Hex dump (1.1.3) ───────────────────────────────────────────────────
# xxd-style: "OFFSET  HH HH HH HH HH HH HH HH  HH HH HH HH HH HH HH HH  |ASCII|\n"
# Triggered explicitly via --hex/-x or as auto-fallback when binary
# content is detected (1.1.3 replaces the pre-1.1.3 skip-notice).
# Plain mode (-p) still streams bytes verbatim — cat-parity is sacred.

fn _hex_byte_pair(buf, off, c) {
    var hi = c / 16;
    var lo = c % 16;
    if (hi < 10) { store8(buf + off,     48 + hi); }
    else         { store8(buf + off,     87 + hi); }
    if (lo < 10) { store8(buf + off + 1, 48 + lo); }
    else         { store8(buf + off + 1, 87 + lo); }
    return 0;
}

# Write an 8-digit hex offset into buf starting at off. Big-endian.
fn _hex_offset(buf, off, value) {
    var i = 7;
    var v = value;
    while (i >= 0) {
        var d = v % 16;
        if (d < 10) { store8(buf + off + i, 48 + d); }
        else        { store8(buf + off + i, 87 + d); }
        v = v / 16;
        i = i - 1;
    }
    return 0;
}

# Emit one 16-byte hex line. n may be < 16 for the trailing partial.
fn _hex_emit_line(buf, n, base_offset) {
    var line[80];
    _hex_offset(&line, 0, base_offset);
    store8(&line + 8,  32);
    store8(&line + 9,  32);
    var pos = 10;
    var k = 0;
    while (k < 16) {
        if (k < n) {
            _hex_byte_pair(&line, pos, load8(buf + k));
        } else {
            store8(&line + pos,     32);
            store8(&line + pos + 1, 32);
        }
        pos = pos + 2;
        if (k == 7) {
            store8(&line + pos,     32);
            store8(&line + pos + 1, 32);
            pos = pos + 2;
        } else {
            if (k < 15) {
                store8(&line + pos, 32);
                pos = pos + 1;
            }
        }
        k = k + 1;
    }
    store8(&line + pos,     32);
    store8(&line + pos + 1, 32);
    store8(&line + pos + 2, 124);
    pos = pos + 3;
    var a = 0;
    while (a < n) {
        var c = load8(buf + a);
        if (c >= 32) {
            if (c < 127) { store8(&line + pos, c); }
            else         { store8(&line + pos, 46); }
        } else {
            store8(&line + pos, 46);
        }
        pos = pos + 1;
        a = a + 1;
    }
    store8(&line + pos, 124);
    pos = pos + 1;
    store8(&line + pos, 10);
    pos = pos + 1;
    out_write(&line, pos);
    return 0;
}

# Stream a file as xxd-style hex. first_buf holds bytes already read
# from fd (e.g. by render_path for binary detection). Caller closes fd.
fn _hex_dump_fd(fd, first_buf, first_n) {
    var pending[16];
    var pending_len = 0;
    var off = 0;

    var i = 0;
    while (i < first_n) {
        store8(&pending + pending_len, load8(first_buf + i));
        pending_len = pending_len + 1;
        if (pending_len == 16) {
            _hex_emit_line(&pending, 16, off);
            off = off + 16;
            pending_len = 0;
        }
        i = i + 1;
    }

    var buf = _buf_loop();
    if (buf == 0) { return 0 - 1; }
    var done = 0;
    while (done == 0) {
        var n = file_read(fd, buf, BUFSIZE);
        if (n < 0) { return 0 - 1; }
        if (n == 0) {
            done = 1;
            continue;
        }
        var j = 0;
        while (j < n) {
            store8(&pending + pending_len, load8(buf + j));
            pending_len = pending_len + 1;
            if (pending_len == 16) {
                _hex_emit_line(&pending, 16, off);
                off = off + 16;
                pending_len = 0;
            }
            j = j + 1;
        }
    }
    if (pending_len > 0) {
        _hex_emit_line(&pending, pending_len, off);
    }
    return 0;
}

fn render_reset() {
    g_line_no = 1;
    g_render_active_color = 0 - 1;
    g_at_line_start = 1;
    escape_reset();
    g_render_done = 0;
    g_wrap_col = 0;
    return 0;
}

# Is g_line_no inside the user's --line-range window?
fn _in_range() {
    if (g_line_range_start > 0) {
        if (g_line_no < g_line_range_start) { return 0; }
    }
    if (g_line_range_end > 0) {
        if (g_line_no > g_line_range_end) { return 0; }
    }
    if (g_flag_diff == 1) {
        if (vcs_mark_for_line(g_line_no) == VCS_MARK_NONE) { return 0; }
    }
    return 1;
}

# 1.1.8/1.1.9 — wrap line break with continuation gutter. Saves the
# active token color (set by `_render_highlighted_with_tb`), resets
# so the gutter renders cleanly in lineno color, then restores the
# token color so the next byte continues with its highlighting intact.
# render_chunk leaves g_render_active_color at -1 so the save/restore
# is a no-op. 1.1.9: continuation glyph is U+21AA "↪" (3 bytes) so
# wrapped rows are visually distinct from the U+2502 "│" divider that
# starts a new file line.
fn _emit_wrap_break() {
    var saved = g_render_active_color;
    if (saved != 0 - 1) {
        if (g_want_color == 1) { ansi_reset(); }
    }
    out_write("\n", 1);
    if (g_want_color == 1) { ansi_fg(theme_lineno_color(g_active_theme)); }
    # With line numbers the arrow sits under the gutter divider; without,
    # there is no gutter to align with (and none was subtracted from the
    # wrap budget), so it starts the row.
    if (resolved_show_numbers() == 1) {
        var div_col = _gutter_divider_col();
        var pad = 0;
        while (pad < div_col) {
            out_write(" ", 1);
            pad = pad + 1;
        }
    }
    out_write("↪ ", 4);
    if (g_want_color == 1) { ansi_reset(); }
    if (saved != 0 - 1) {
        if (g_want_color == 1) { ansi_fg(saved); }
    }
    return 0;
}

# Range-gated stdout write. Identical to out_write(…) when
# no range is set; one comparison + branch overhead otherwise.
fn _emit(buf, n) {
    if (_in_range() == 0) { return 0; }
    # Fast paths: plain mode (sacred) or wrap inactive. g_wrap_cols is
    # 0 unless resolve_mode turned wrap on (--wrap=character forces it
    # always; 1.1.8 --wrap=auto turns it on whenever the decorated
    # frame is rendering, so wrapped content stays inside the bottom
    # rule).
    if (g_flag_plain == 1) { out_write(buf, n); return 0; }
    if (g_wrap_cols == 0)  { out_write(buf, n); return 0; }

    # Wrap path: byte-by-byte with column tracking. Insert a wrap-\n
    # + continuation gutter before any UTF-8 leading byte that would
    # push past g_wrap_cols. Continuation bytes (0x80..0xBF) don't
    # count as columns, so multi-byte codepoints stay intact across
    # wraps. File-origin \n resets g_wrap_col without a continuation
    # gutter (next line gets its own emit_lineno from the caller).
    var k = 0;
    while (k < n) {
        var c = load8(buf + k);
        if (c == 10) {
            out_write(buf + k, 1);
            g_wrap_col = 0;
        } else { if (c == 13) {
            out_write(buf + k, 1);
        } else {
            var is_cont = 0;
            if (c >= 0x80) {
                if (c < 0xC0) { is_cont = 1; }
            }
            if (is_cont == 0) {
                if (g_wrap_col >= g_wrap_cols) {
                    _emit_wrap_break();
                    g_wrap_col = 0;
                    if (resolved_show_numbers() == 0) { g_wrap_col = 2; }   # the "↪ "
                }
                g_wrap_col = g_wrap_col + 1;
            }
            out_write(buf + k, 1);
        } }
        k = k + 1;
    }
    return 0;
}

# Is file-origin escape stripping active for the current render?
# Plain mode is cat parity (no stripping), -A renders every control
# visibly (so stripping would double-hide), --raw-control-chars is the
# explicit opt-out. Without color decoration, file bytes aren't
# mingled with owl's own SGR output, so the injection path doesn't
# exist — skip stripping to preserve cat-parity latency.
fn _strip_active() {
    # Plain mode is sacred — byte-identical to cat regardless of any
    # other flag (CLAUDE.md). show-all renders escapes as ^[ glyphs,
    # so stripping would double-hide them.
    if (g_flag_plain == 1)        { return 0; }
    if (g_flag_show_all == 1)     { return 0; }
    # Explicit overrides — these only fire in non-plain mode and so
    # never threaten cat-parity. always wins over -r intentionally:
    # the more recently-named knob takes priority.
    if (g_flag_strip_ansi == 1)   { return 1; }   # --strip-ansi=always
    if (g_flag_strip_ansi == 2)   { return 0; }   # --strip-ansi=never
    if (g_flag_raw_controls == 1) { return 0; }   # -r / --raw-control-chars
    # Auto: strip whenever owl draws a frame or colour for a human — a
    # decorated (TTY or -n) or coloured render. Passthrough only for the
    # undecorated, uncoloured stream (piped output), which is cat-like by
    # contract. Through 1.5.2 this keyed on colour alone, so NO_COLOR or
    # --color=never on a terminal drew the frame and passed every file
    # escape straight through (audit 2026-10-31 FINDING-014, re-opening
    # FINDING-001).
    if (g_want_color == 0) { if (g_decorated == 0) { return 0; } }
    return 1;
}

# Render one buffered chunk through the resolved pipeline:
#   - line-number gutter (from g_flag_numbers / decorated mode)
#   - tab expansion (g_flag_tabs spaces, or literal if 0)
#   - visible non-printables (g_flag_show_all: → for tab, $ for \n,
#     ␍ for CR, ^X / ^? for other control chars)
#
# Three dispatch paths, fastest to slowest:
#   1. No transforms      → bulk file_write of the whole chunk
#   2. Line-numbers only  → chunk-flush on each \n (M2 path)
#   3. Any transform      → byte-by-byte
fn render_chunk(buf, n) {
    # -p is cat-parity: byte-identical passthrough, regardless of -A /
    # --tabs / -n / any other transform flag the user also set. The
    # one exception is --line-range — a user who explicitly asks for
    # lines [A,B] of a file is opting out of full passthrough.
    if (g_flag_plain == 1) {
        if (g_line_range_start == 0) {
            if (g_line_range_end == 0) {
                out_write(buf, n);
                return 0;
            }
        }
        var pi = 0;
        while (pi < n) {
            var pc = load8(buf + pi);
            _emit(buf + pi, 1);
            if (pc == 10) {
                g_line_no = g_line_no + 1;
                if (g_line_range_end > 0) {
                    if (g_line_no > g_line_range_end) {
                        g_render_done = 1;
                        return 0;
                    }
                }
            }
            pi = pi + 1;
        }
        return 0;
    }

    var show_nums = resolved_show_numbers();
    var show_all  = g_flag_show_all;
    var tabs      = g_flag_tabs;
    var strip     = _strip_active();

    var range_active = 0;
    if (g_line_range_start > 0) { range_active = 1; }
    if (g_line_range_end > 0)   { range_active = 1; }

    # Path 1: no transforms at all. Safe for bulk write only when
    # escape-stripping is off — otherwise we'd leak file-origin
    # escapes straight to the terminal. Skipped under --line-range
    # because the bulk spans newlines that would need per-line gating.
    if (strip == 0) {
        if (range_active == 0) {
            if (g_wrap_cols == 0) {
                if (show_nums == 0) {
                    if (show_all == 0) {
                        if (tabs == 0) {
                            out_write(buf, n);
                            return 0;
                        }
                    }
                }
            }
        }

        # Path 2: only line numbers, no byte-level changes. Range
        # filter applies via _emit (each bulk write covers exactly
        # one line ending at \n, so per-line gating is correct).
        if (show_nums == 1) {
            if (show_all == 0) {
                if (tabs == 0) {
                    var start = 0;
                    var j = 0;
                    while (j < n) {
                        if (g_at_line_start == 1) {
                            emit_lineno(g_line_no);
                            g_at_line_start = 0;
                        }
                        if (load8(buf + j) == 10) {
                            _emit(buf + start, j - start + 1);
                            start = j + 1;
                            g_line_no = g_line_no + 1;
                            g_at_line_start = 1;
                            if (g_line_range_end > 0) {
                                if (g_line_no > g_line_range_end) {
                                    g_render_done = 1;
                                    return 0;
                                }
                            }
                        }
                        j = j + 1;
                    }
                    if (start < n) {
                        _emit(buf + start, n - start);
                    }
                    return 0;
                }
            }
        }
    }

    # Path 3: any transform active — byte-by-byte.
    var i = 0;
    while (i < n) {
        if (show_nums == 1) {
            if (g_at_line_start == 1) {
                emit_lineno(g_line_no);
                g_at_line_start = 0;
            }
        }
        var c = load8(buf + i);

        # Strip file-origin terminal escapes (audit FINDING-001).
        # When the classifier swallows a byte, skip all emission AND
        # all state updates so line counters / tab expansion don't
        # fire inside an escape sequence.
        if (strip == 1) {
            if (_emit_file_byte(c) == 0) { i = i + 1; continue; }
        }

        if (c == 10) {
            if (show_all == 1) { _emit("$", 1); }
            _emit("\n", 1);
            g_line_no = g_line_no + 1;
            g_at_line_start = 1;
            if (g_line_range_end > 0) {
                if (g_line_no > g_line_range_end) {
                    g_render_done = 1;
                    return 0;
                }
            }
        } else {
            if (c == 9) {
                if (show_all == 1) {
                    _emit("→", 3);
                    var pad = tabs - 1;
                    if (pad < 0) { pad = 0; }
                    var p = 0;
                    while (p < pad) {
                        _emit(" ", 1);
                        p = p + 1;
                    }
                } else {
                    if (tabs == 0) {
                        _emit("\t", 1);
                    } else {
                        var p = 0;
                        while (p < tabs) {
                            _emit(" ", 1);
                            p = p + 1;
                        }
                    }
                }
            } else {
                if (c == 13) {
                    if (show_all == 1) {
                        _emit("␍", 3);
                    } else {
                        _emit(buf + i, 1);
                    }
                } else {
                    if (show_all == 1) {
                        if (c < 32) {
                            var ctrl[2];
                            store8(&ctrl, 94);
                            store8(&ctrl + 1, c + 64);
                            _emit(&ctrl, 2);
                        } else {
                            if (c == 127) {
                                _emit("^?", 2);
                            } else {
                                _emit(buf + i, 1);
                            }
                        }
                    } else {
                        _emit(buf + i, 1);
                    }
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

# ── Highlighted render (M3b) ───────────────────────────────────────────
#
# Called when language is detected, vyakarana has a grammar for it, and
# color output is live. `buf` is the full file contents; `n` is the
# byte length (load-bearing for the streaming feed call — vyakarana
# 2.x doesn't strlen internally any more, the explicit length is
# what bounds tokenization). Returns 0 on success, -1 if tokenization
# returned no tokenbuf (caller falls back to plain passthrough on the
# same buffer).
#
# Vyakarana 2.0.0 (ADR 0017) replaced the one-shot `tokenize_source`
# with the push-based streaming primitive. owl's slurp callers in
# `render_fd` / `render_path` drive the stream lifecycle themselves
# (1.3.6 lift) so per-chunk feed during the read loop keeps
# vyakarana's scanner state bounded by the live in-progress span
# (vyakarana 2.0.1's rolling buffer) rather than total input. This
# wrapper is the simple one-shot variant kept for any caller that
# wants to tokenize a buffer it already has in memory; it just
# new/feed/finish/free's the stream and forwards to
# `_render_highlighted_with_tb`.
#
# Layering: drives the loop byte-by-byte so the line-number gutter, tab
# expansion, and -A non-printable glyphs all still work — M3b adds
# color on top of M2/M5 behaviors, it doesn't replace them. ANSI reset
# is emitted before newlines so line endings don't bleed color into
# the next gutter.
# Render `buf` (n bytes) with token coloring driven by `tb` (a tokenbuf
# already populated by the caller's stream lifecycle). Caller owns
# the stream + tokenbuf; this fn only reads `tb`. Both highlight
# slurp paths in `render_fd` and `render_path` drive the streaming
# tokenizer themselves so they can feed each `file_read` chunk
# incrementally (1.3.6 HIGHLIGHT_MAX lift) — see those call sites
# for the new/feed*/finish/free dance, then this helper for the
# render loop.
fn _render_highlighted_with_tb(buf, n, tb) {
    if (tb == 0) { return 0 - 1; }

    var tok_count = tokenbuf_count(tb);
    var tok_i = 0;
    var show_nums = resolved_show_numbers();
    var show_all  = g_flag_show_all;
    var tabs      = g_flag_tabs;
    var theme     = g_active_theme;
    g_render_active_color = 0 - 1;
    var strip     = _strip_active();
    # Kind -> colour, computed once per render instead of per byte
    # (theme_token_color is kind_name + up to 7 streq). Kinds past the table
    # fall back to the direct lookup.
    var kcol[128];
    var kk = 0;
    while (kk < 16) {
        store64(&kcol + kk * 8, theme_token_color(theme, kk));
        kk = kk + 1;
    }

    var i = 0;
    while (i < n) {
        # Advance past tokens that ended before this byte.
        while (tok_i < tok_count) {
            var tok_end = tokenbuf_start(tb, tok_i) + tokenbuf_len(tb, tok_i);
            if (tok_end <= i) { tok_i = tok_i + 1; }
            else { break; }
        }
        var kind = 0 - 1;
        if (tok_i < tok_count) {
            if (tokenbuf_start(tb, tok_i) <= i) {
                kind = tokenbuf_kind(tb, tok_i);
            }
        }
        var color = 0 - 1;
        if (kind >= 0) {
            if (kind < 16) { color = load64(&kcol + kind * 8); }
            else { color = theme_token_color(theme, kind); }
        }

        var c = load8(buf + i);

        # Line-number gutter at line start — clear any active color so
        # the gutter renders in its own lineno color.
        if (show_nums == 1) {
            if (g_at_line_start == 1) {
                if (g_render_active_color != 0 - 1) { ansi_reset(); g_render_active_color = 0 - 1; }
                emit_lineno(g_line_no);
                g_at_line_start = 0;
            }
        }

        # Strip file-origin terminal escapes (audit FINDING-001). Done
        # after the gutter — if the first byte of a new line is the
        # start of an escape, we still want the lineno drawn.
        if (strip == 1) {
            if (_emit_file_byte(c) == 0) { i = i + 1; continue; }
        }

        # Color transitions: reset before \n, otherwise apply this
        # token's color if different from what's active.
        if (c == 10) {
            if (g_render_active_color != 0 - 1) { ansi_reset(); g_render_active_color = 0 - 1; }
        } else {
            if (_in_range() == 1) {
                if (color != g_render_active_color) {
                    if (g_render_active_color != 0 - 1) { ansi_reset(); }
                    if (color != 0 - 1) { ansi_fg(color); }
                    g_render_active_color = color;
                }
            }
        }

        # Byte-level emission — mirrors render_chunk path 3.
        if (c == 10) {
            if (show_all == 1) { _emit("$", 1); }
            _emit("\n", 1);
            g_line_no = g_line_no + 1;
            g_at_line_start = 1;
            if (g_line_range_end > 0) {
                if (g_line_no > g_line_range_end) {
                    if (g_render_active_color != 0 - 1) { ansi_reset(); }
                    g_render_done = 1;
                    return 0;
                }
            }
        } else {
            if (c == 9) {
                if (show_all == 1) {
                    _emit("→", 3);
                    var pad = tabs - 1;
                    if (pad < 0) { pad = 0; }
                    var p = 0;
                    while (p < pad) {
                        _emit(" ", 1);
                        p = p + 1;
                    }
                } else {
                    if (tabs == 0) {
                        _emit("\t", 1);
                    } else {
                        var p = 0;
                        while (p < tabs) {
                            _emit(" ", 1);
                            p = p + 1;
                        }
                    }
                }
            } else {
                if (c == 13) {
                    if (show_all == 1) {
                        _emit("␍", 3);
                    } else {
                        _emit(buf + i, 1);
                    }
                } else {
                    if (show_all == 1) {
                        if (c < 32) {
                            var ctrl[2];
                            store8(&ctrl, 94);
                            store8(&ctrl + 1, c + 64);
                            _emit(&ctrl, 2);
                        } else {
                            if (c == 127) {
                                _emit("^?", 2);
                            } else {
                                _emit(buf + i, 1);
                            }
                        }
                    } else {
                        _emit(buf + i, 1);
                    }
                }
            }
        }
        i = i + 1;
    }

    if (g_render_active_color != 0 - 1) { ansi_reset(); }
    g_render_active_color = 0 - 1;
    return 0;
}

# ── Shared buffers and the slurp (1.5.3) ──────────────────────────────
# Allocated once and reused for every file. Through 1.5.2 each file took
# its own read buffers and a fresh 16 MiB highlight buffer and tokenbuf on
# the never-freed heap, so `owl src/*` on a terminal grew ~3.75 MB per
# highlighted file (audit 2026-10-31 FINDING-022). Uses are sequential —
# one file at a time — so sharing is safe.
var g_loop_buf    = 0;    # BUFSIZE: render_fd_loop, _follow_loop, _hex_dump_fd
var g_first_buf   = 0;    # BUFSIZE: render_path's first chunk
var g_hl_buf      = 0;    # HIGHLIGHT_MAX + 1: the slurp buffer
var g_hl_tb       = 0;    # the tokenbuf
var g_hl_overflow = 0;    # set by _hl_slurp

fn _buf_loop()  { if (g_loop_buf == 0)  { g_loop_buf  = alloc(BUFSIZE); } return g_loop_buf; }
fn _buf_first() { if (g_first_buf == 0) { g_first_buf = alloc(BUFSIZE); } return g_first_buf; }
fn _buf_hl()    { if (g_hl_buf == 0)    { g_hl_buf    = alloc(HIGHLIGHT_MAX + 1); } return g_hl_buf; }

# The tokenbuf, emptied for reuse. `_tokenbuf_reset` is vyakarana-private
# (as `_grammars_bootstrapped` is); a rename upstream fails the build
# loudly rather than silently.
fn _hl_tokenbuf() {
    if (g_hl_tb == 0) { g_hl_tb = tokenbuf_new(); return g_hl_tb; }
    _tokenbuf_reset(g_hl_tb);
    return g_hl_tb;
}

# Slurp fd into the shared highlight buffer, feeding each chunk to stream
# `s`. `pre`/`pre_n` are bytes already read (render_path's first chunk).
# Returns the byte count in the buffer, -1 on a read error, -2 when the
# buffer cannot be allocated. Sets g_hl_overflow = 1 when the input does
# not fit — more than HIGHLIGHT_MAX bytes, or a feed the stream refused —
# and then the stream must not be finished; every byte read so far,
# including the overflow probe, is in the buffer for the caller's plain
# fallback. Through 1.5.2 the probe byte was read and dropped (audit
# 2026-10-31 FINDING-028) and feed results were ignored (FINDING-018).
fn _hl_slurp(fd, s, pre, pre_n) {
    g_hl_overflow = 0;
    var big = _buf_hl();
    if (big == 0) { return 0 - 2; }
    var total = 0;
    if (pre_n > 0) {
        memcpy(big, pre, pre_n);
        total = pre_n;
        if (tokenize_stream_feed(s, big, pre_n) != VYK_OK) { g_hl_overflow = 1; return total; }
    }
    while (total < HIGHLIGHT_MAX) {
        var got = file_read(fd, big + total, HIGHLIGHT_MAX - total);
        if (got < 0) { return 0 - 1; }
        if (got == 0) { return total; }
        var fr = tokenize_stream_feed(s, big + total, got);
        total = total + got;
        if (fr != VYK_OK) { g_hl_overflow = 1; return total; }
    }
    # Exactly full: one more byte decides. It goes into the buffer (there is
    # room for one) so the plain fallback still renders it.
    var pr = file_read(fd, big + total, 1);
    if (pr > 0) { g_hl_overflow = 1; total = total + 1; }
    return total;
}

# Byte size of an open fd, or -1 when the kernel cannot say (a pipe, a
# /proc file — both report something, so only trust a regular file's).
fn _fd_size(fd) {
    var st[256];
    if (sys_fstat(fd, &st) != 0) { return 0 - 1; }
    if ((load32(&st + STAT_MODE) & 0xF000) != 0x8000) { return 0 - 1; }
    return load64(&st + STAT_SIZE);
}

# The one "too large to highlight" notice. `what` is ": file" or ": input".
fn _too_large_notice(path, what) {
    out_flush();
    eprint("owl: ", 5);
    eprint_sanitized(path, strlen(path));
    eprint(what, strlen(what));
    var msg = " too large for highlighting (> ";
    eprint(msg, strlen(msg));
    var mb_buf[12];
    var mb = (HIGHLIGHT_MAX + 1) / 1048576;
    var mpi = 11;
    store8(&mb_buf + mpi, 0);
    mpi = mpi - 1;
    if (mb == 0) { store8(&mb_buf + mpi, 48); mpi = mpi - 1; }
    while (mb > 0) {
        store8(&mb_buf + mpi, 48 + mb % 10);
        mpi = mpi - 1;
        mb = mb / 10;
    }
    mpi = mpi + 1;
    eprint(&mb_buf + mpi, 11 - mpi);
    var tail = " MB), rendering without color\n";
    eprint(tail, strlen(tail));
    return 0;
}

fn render_fd_loop(fd) {
    var buf = _buf_loop();
    if (buf == 0) { return 0 - 1; }
    while (1 == 1) {
        if (g_render_done == 1) { return 0; }
        var n = file_read(fd, buf, BUFSIZE);
        if (n < 0) { g_read_errno = n; return 0 - 1; }
        if (n == 0) { return 0; }
        render_chunk(buf, n);
    }
    return 0;
}

fn render_fd(fd, path_for_header) {
    render_reset();
    vcs_reset();

    var lang = "plain";
    if (g_flag_lang != 0) { lang = g_flag_lang; }
    g_active_lang = lang;

    # Stdin gets the output formats a file does. Through 1.5.2 render_fd had
    # no ndjson or hex branch, so `owl --format=ndjson -` passed the input
    # through raw — a forged JSON line reached the consumer as a token
    # record — and `--hex -` printed raw bytes (audit 2026-10-31 FINDING-016).
    if (g_flag_format == FORMAT_NDJSON) {
        return _render_ndjson(fd, path_for_header, lang, 0, 0);
    }
    if (g_flag_hex == 1) {
        if (g_flag_plain == 0) {
            if (resolved_show_header() == 1) { emit_header(path_for_header); }
            return _hex_dump_fd(fd, 0, 0);
        }
    }

    if (resolved_show_header() == 1) { emit_header(path_for_header); }

    # Highlight eligibility — same gate as render_path. Stdin gets the
    # same token color treatment as a file path when --language is set
    # and color is live. Without --language there's no extension or
    # path to detect from, so stdin without a hint stays plain.
    var highlight_ok = 0;
    if (g_want_color == 1) {
        if (streq(lang, "plain") == 0) {
            if (_owl_has_grammar(lang) == 1) { highlight_ok = 1; }
        }
    }

    if (highlight_ok == 0) {
        return render_fd_loop(fd);
    }

    # Slurp up to HIGHLIGHT_MAX, feeding each chunk to vyakarana's
    # streaming tokenizer as it arrives (1.3.6 lift). Stdin can be
    # unbounded so we cap and fall back to streaming on overflow.
    # The stream lifecycle (new/feed*/finish/free) is driven here
    # so per-chunk feed keeps vyakarana's scanner state bounded by
    # the live span (vyakarana 2.0.1's rolling buffer) instead of
    # total input; `_render_highlighted_with_tb` then walks the
    # populated tokenbuf for the byte-by-byte render.
    # One extra byte for a defensive trailing \0 (cstr-shape buffer
    # for any consumer that touches it; not load-bearing for the
    # streaming feed, which takes explicit length).
    var s = tokenize_stream_new(lang);
    if (s == 0) {
        # Grammar dropped between the has_grammar probe and now (or
        # the stream ctor failed for another reason). Fall back to
        # plain streaming — same shape as highlight_ok == 0 above.
        return render_fd_loop(fd);
    }
    var total = _hl_slurp(fd, s, 0, 0);
    if (total == (0 - 1)) { tokenize_stream_free(s); return 0 - 1; }
    if (total == (0 - 2)) { tokenize_stream_free(s); return render_fd_loop(fd); }   # FINDING-011
    var big = g_hl_buf;

    if (g_hl_overflow == 0) {
        store8(big + total, 0);
        var tb = _hl_tokenbuf();
        tokenize_stream_finish(s, tb);
        tokenize_stream_free(s);
        var hrc = _render_highlighted_with_tb(big, total, tb);
        if (hrc != 0) { render_chunk(big, total); }
        return 0;
    }
    tokenize_stream_free(s);

    # Too large: say so, then render what was read and the rest plainly.
    _too_large_notice(path_for_header, ": input");
    render_chunk(big, total);
    var rc_big = render_fd_loop(fd);
    if (rc_big < 0) { return 0 - 1; }
    return 0;
}

# Tail an open fd: render whatever arrives, sleep when it is quiet, repeat.
# Ends only on read error or signal (Ctrl-C) — like `tail -f`, there is no
# natural end.
#
# The tail is rendered through `render_chunk`, NOT the highlight path, and
# the whole follow session is forced down that path so the output is
# consistent from the first byte. That is a deliberate trade, not an
# oversight: token colouring needs a tokenbuf whose spans cover the bytes
# being drawn, and a live stream produces spans in absolute stream offsets
# while the render loop indexes into the chunk it was handed. Reconciling
# the two means threading a base offset through the render loop and
# reasoning about tokens that straddle an append boundary — real work with
# real correctness risk, for a mode whose value is *seeing new lines
# arrive*. Everything else survives: the line-number gutter, tab expansion,
# `-A` glyphs, wrap, and — the one that matters — escape stripping, so a
# log line carrying a terminal escape is filtered exactly as it is in the
# normal viewer.
fn _follow_loop(fd, path) {
    var buf = _buf_loop();
    if (buf == 0) { return 0 - 1; }
    var quiet = 0;
    while (quiet == 0) {
        var n = file_read(fd, buf, BUFSIZE);
        if (n < 0) { return 0 - 1; }
        if (n == 0) {
            # Truncated under us (logrotate copytruncate, `: > log`): start
            # over from the top, as `tail -f` does. Through 1.5.2 owl went
            # silent and later printed a torn fragment (audit 2026-10-31).
            var sz = _fd_size(fd);
            if (sz >= 0) {
                var cur = sys_lseek(fd, 0, 1);
                if (cur > sz) {
                    sys_lseek(fd, 0, 0);
                    escape_reset();
                    out_flush();
                    eprint("owl: ", 5);
                    eprint_sanitized(path, strlen(path));
                    eprint(": file truncated\n", 17);
                    continue;
                }
            }
            out_flush();
            sleep_ms(FOLLOW_POLL_MS);
            continue;
        }
        render_chunk(buf, n);
    }
    return 0;
}

# ndjson render path. Slurps up to HIGHLIGHT_MAX, drives the same
# streaming tokenizer the highlight path uses, then emits the tokenbuf.
# `first_buf`/`first_n` are the bytes render_path already read for binary
# detection, so the stream still sees the file in order.
#
# Returns 0 on success, -1 on error (message already reported).
fn _render_ndjson(fd, path, lang, first_buf, first_n) {
    if (streq(lang, "plain") == 1) {
        report_error(path, "no grammar for this file (--format=ndjson needs one; try --language=<name>)");
        return 0 - 1;
    }
    if (_owl_has_grammar(lang) == 0) {
        report_error(path, "no grammar for this file (--format=ndjson needs one; try --language=<name>)");
        return 0 - 1;
    }
    var s = tokenize_stream_new(lang);
    if (s == 0) {
        report_error(path, "tokenizer unavailable");
        return 0 - 1;
    }
    # A regular file larger than the cap is refused before tokenizing it.
    if (_fd_size(fd) > HIGHLIGHT_MAX) {
        tokenize_stream_free(s);
        report_error(path, "input too large for --format=ndjson");
        return 0 - 1;
    }
    var total = _hl_slurp(fd, s, first_buf, first_n);
    if (total == (0 - 2)) {
        tokenize_stream_free(s);
        report_error(path, "out of memory");
        return 0 - 1;
    }
    if (total == (0 - 1)) {
        tokenize_stream_free(s);
        report_error(path, "read error");
        return 0 - 1;
    }
    # Oversized input is a hard error here rather than the viewer's
    # quiet degrade-to-plain: a truncated token stream that still looks
    # well-formed is worse for a consumer than no stream at all. That now
    # includes a feed the stream refused (FINDING-018).
    if (g_hl_overflow == 1) {
        tokenize_stream_free(s);
        report_error(path, "input too large for --format=ndjson");
        return 0 - 1;
    }
    var big = g_hl_buf;
    store8(big + total, 0);
    var tb = _hl_tokenbuf();
    tokenize_stream_finish(s, tb);
    tokenize_stream_free(s);
    return _emit_ndjson(big, total, tb);
}

# Render a file path. Performs extension-based language detection, a
# shebang peek on the first chunk if the extension didn't resolve,
# and honors --language override. M3b splits into two render paths:
#
#   - Highlighted: file fits in HIGHLIGHT_MAX, color is live, and
#     vyakarana has a grammar for the detected language. Whole file
#     is buffered, tokenized once, and rendered with per-token color.
#   - Streaming: everything else (big files, no grammar, no color,
#     plain mode). First chunk renders through render_chunk, rest
#     through render_fd_loop.
fn render_path(path) {
    var fd = file_open(path, O_RDONLY, 0);
    if (fd < 0) {
        report_error(path, _errno_msg(fd));
        return 0 - 1;
    }

    var lang = detect_language_from_path(path);

    var first_buf = _buf_first();
    if (first_buf == 0) { file_close(fd); report_error(path, "out of memory"); return 0 - 1; }
    var first_n = file_read(fd, first_buf, BUFSIZE);
    if (first_n < 0) {
        file_close(fd);
        report_error(path, _errno_msg(first_n));
        return 0 - 1;
    }

    # 1.1.3 — explicit --hex / -x: dump as xxd-style and exit. Wins over
    # everything except -p (cat-parity is sacred). Header still emits
    # under decorated mode so the user sees what they're looking at.
    if (g_flag_hex == 1) {
        if (g_flag_plain == 0) {
            if (resolved_show_header() == 1) { emit_header(path); }
            var hrc = _hex_dump_fd(fd, first_buf, first_n);
            file_close(fd);
            if (hrc < 0) {
                report_error(path, "read error");
                return 0 - 1;
            }
            return 0;
        }
    }

    # Binary file detection — a NUL byte in the first chunk is a strong
    # signal the file isn't meant for terminal display. Skip unless the
    # user explicitly asked for text mode: `-p` (cat parity), `-A`
    # (raw-byte escape view), or `--language=<name>` (asserted type).
    if (g_flag_plain == 0) {
        if (g_flag_show_all == 0) {
            if (g_flag_lang == 0) {
                var nul_hit = 0;
                var j = 0;
                while (j < first_n) {
                    if (load8(first_buf + j) == 0) {
                        nul_hit = 1;
                        j = first_n;
                        continue;
                    }
                    j = j + 1;
                }
                if (nul_hit == 1) {
                    # 1.1.3 — auto-fallback: instead of the pre-1.1.3
                    # "binary file (use -p to dump)" skip-notice, dump
                    # the file as xxd-style hex. Header still emits in
                    # decorated mode so the user sees what they're
                    # looking at.
                    if (resolved_show_header() == 1) { emit_header(path); }
                    var rc = _hex_dump_fd(fd, first_buf, first_n);
                    file_close(fd);
                    if (rc < 0) {
                        report_error(path, "read error");
                        return 0 - 1;
                    }
                    return 0;
                }
            }
        }
    }

    if (streq(lang, "plain") == 1) {
        if (first_n > 0) {
            var sh = detect_language_from_shebang(first_buf, first_n);
            if (sh != 0) { lang = sh; }
        }
    }

    # 1.1.4 — content-based detection as a third-pass fallback. Fires
    # only when extension AND shebang both missed; high-confidence
    # patterns for json/yaml/toml/markdown only (programming languages
    # excluded — false-positive risk).
    if (streq(lang, "plain") == 1) {
        if (first_n > 0) {
            var ct = _owl_detect_language_from_content(first_buf, first_n);
            if (ct != 0) { lang = ct; }
        }
    }

    if (g_flag_lang != 0) { lang = g_flag_lang; }

    g_active_lang = lang;

    # ── ndjson ──────────────────────────
    # Machine output: tokenize and emit, no gutter, no VCS, no wrap, no
    # header. Needs a grammar — without one there are no tokens to emit,
    # and silently producing an empty stream would look like "this file has
    # no content" to a consumer, so it fails loudly instead.
    if (g_flag_format == FORMAT_NDJSON) {
        var nrc = _render_ndjson(fd, path, lang, first_buf, first_n);
        file_close(fd);
        return nrc;
    }

    # Compute VCS markers before any rendering — gutter (M3a) and
    # highlighted-byte loop (M3b) both read through vcs_mark_for_line.
    # Silent no-op when not in a repo, not decorated, or --no-changes.
    vcs_compute_markers(path);

    # 1.1.11 — recompute wrap budget now that vcs_enabled() reflects
    # the current file. Without this the budget would be stuck on
    # whatever resolve_mode picked at startup (VCS-off-conservative),
    # and a VCS-active file would overflow the right rule by 2 cols.
    _recompute_wrap_cols();

    # Highlighting eligibility. Gated on color (not on decorated) —
    # piped output with --color=always should still color tokens even
    # though the header/gutter stay off. Plain-mode (-p) already forced
    # g_want_color to 0 upstream. `has_grammar` also lazily loads all
    # bundled grammars on first call — cheap after the first file.
    var highlight_ok = 0;
    if (g_want_color == 1) {
        if (streq(lang, "plain") == 0) {
            if (_owl_has_grammar(lang) == 1) { highlight_ok = 1; }
        }
    }
    # --follow renders the whole session through the streaming path so the
    # already-present content and the appended tail look the same. See
    # _follow_loop for why the tail is not token-coloured.
    if (g_flag_follow == 1) { highlight_ok = 0; }

    render_reset();
    if (resolved_show_header() == 1) { emit_header(path); }

    # A regular file already known to be over the cap is not slurped and
    # tokenized only to be refused at the end (~2 s for 16 MiB).
    if (highlight_ok == 1) {
        if (_fd_size(fd) > HIGHLIGHT_MAX) {
            _too_large_notice(path, ": file");
            highlight_ok = 0;
        }
    }

    if (highlight_ok == 1) {
        # Buffer the whole file (up to HIGHLIGHT_MAX), feeding each chunk
        # to vyakarana's streaming tokenizer as it arrives (1.3.6 lift);
        # the first_n bytes read for binary detection go first, so the
        # stream sees the file in order. `_render_highlighted_with_tb` then
        # walks the populated tokenbuf for the byte-by-byte render.
        var s = tokenize_stream_new(lang);
        if (s == 0) {
            # Grammar dropped between has_grammar probe and now: render the
            # prefix and drain the rest plainly.
            render_chunk(first_buf, first_n);
            var rc0 = render_fd_loop(fd);
            file_close(fd);
            if (rc0 < 0) { return 0 - 1; }
            return 0;
        }
        var total = _hl_slurp(fd, s, first_buf, first_n);
        if (total == (0 - 1)) {
            tokenize_stream_free(s);
            file_close(fd);
            report_error(path, "read error");
            return 0 - 1;
        }
        if (total == (0 - 2)) {
            # FINDING-011 — no buffer: stream plainly rather than write
            # through a null pointer.
            tokenize_stream_free(s);
            render_chunk(first_buf, first_n);
            var rcn = render_fd_loop(fd);
            file_close(fd);
            if (rcn < 0) { return 0 - 1; }
            return 0;
        }
        var big = g_hl_buf;

        if (g_hl_overflow == 0) {
            store8(big + total, 0);
            var tb = _hl_tokenbuf();
            tokenize_stream_finish(s, tb);
            tokenize_stream_free(s);
            var hrc = _render_highlighted_with_tb(big, total, tb);
            file_close(fd);
            if (hrc != 0) {
                # Tokenization bailed — emit the buffer plainly so the
                # user still sees the file (decorations already drawn).
                render_chunk(big, total);
            }
            return 0;
        }
        tokenize_stream_free(s);

        # Too large after all (it grew, or the size was not knowable): say
        # why colour is missing, then render what was read and the rest
        # plainly — line numbers, -A and tabs all still apply.
        _too_large_notice(path, ": file");
        render_chunk(big, total);
        var rc_big = render_fd_loop(fd);
        file_close(fd);
        if (rc_big < 0) {
            report_error(path, "read error");
            return 0 - 1;
        }
        return 0;
    }

    render_chunk(first_buf, first_n);
    var rc = render_fd_loop(fd);
    # --follow: the file is fully rendered and the fd sits at EOF; hand it
    # to the tail loop, which blocks until Ctrl-C. `highlight_ok` was forced
    # to 0 above, so follow always lands here rather than on a highlight
    # path that has already closed the fd.
    if (g_flag_follow == 1) {
        if (rc >= 0) {
            var frc = _follow_loop(fd, path);
            file_close(fd);
            if (frc < 0) {
                report_error(path, "read error");
                return 0 - 1;
            }
            return 0;
        }
    }
    file_close(fd);
    if (rc < 0) {
        report_error(path, "read error");
        return 0 - 1;
    }
    return 0;
}

# ── CLI ────────────────────────────────────────────────────────────────

fn print_version() {
    println(OWL_VERSION);
    if (g_flag_verbose == 1) {
        # Kept in sync with cyrius.cyml [deps.*].tag and [package].cyrius.
        # Useful for bug reports — "owl 1.5.3 vyakarana 2.10.0 sit 1.13.0
        # cyrius 6.7.18 linux-x86_64" pins the exact toolchain + dep
        # versions a user is running against. sit (1.4.0) backs the VCS
        # change-marker gutter via sit_diff_path.
        println("vyakarana 2.10.0");
        println("sit 1.13.0");
        println("cyrius 6.7.18");
        println("target linux-x86_64");
    }
    return EXIT_OK;
}

fn print_help() {
    println("owl — a watchful file viewer for AGNOS / Cyrius");
    println("");
    println("Usage:");
    println("  owl [OPTIONS] [FILE...]");
    println("  owl -                  Read from stdin");
    println("  owl a.txt - b.txt      Mix files and stdin");
    println("");
    println("Options:");
    println("  -n, --number           Force line numbers on");
    println("  -N, --no-number        Force line numbers off");
    println("  -p, --plain            Plain output (no decorations)");
    println("  -A, --show-all         Show non-printables: tab as →, EOL as $,");
    println("                         CR as ␍, other controls as ^X");
    println("  -x, --hex              xxd-style hex dump (auto for binary files)");
    println("      --diff             Show only changed lines (uses VCS markers)");
    println("  -f, --follow           Keep rendering as the file grows (tail -f; no token colour)");
    println("      --format=<fmt>     text (default) | ndjson (one JSON object per token)");
    println("  -r, --raw-control-chars  Pass file-origin terminal escapes through");
    println("                         unchanged (default: strip in decorated mode)");
    println("      --strip-ansi=<when> auto | always | never (less -R style alias of -r)");
    println("      --tabs=<n>         Expand tabs to N spaces (default 4, 0 = literal)");
    println("      --line-range=A:B   Print only lines A..B (1-indexed; A: or :B open-ended)");
    println("                         head -n N idiom: --line-range=:N");
    println("      --wrap=<mode>      auto | never | character — auto wraps to fit the");
    println("                         decorated frame; never lets long lines overflow");
    println("      --color=<when>     auto | always | never");
    println("      --paging=<when>    auto | always | never");
    println("      --style=<mode>     auto | changes | no-changes (gutter VCS markers)");
    println("      --theme=<name>     Syntax theme (dark | light)");
    println("      --list-themes      List bundled themes");
    println("      --language=<name>  Force language (overrides auto-detect)");
    println("      --list-languages   List recognized languages");
    println("  -h, --help             Show this help and exit");
    println("  -v, --verbose          With --version, also print dep + toolchain pins");
    println("  -V, --version          Show version and exit");
    println("");
    println("Config (optional):");
    println("  $OWL_CONFIG, else $XDG_CONFIG_HOME/owl/config.cyml,");
    println("  else ~/.config/owl/config.cyml. Keys: theme, paging,");
    println("  style, tabs, wrap, ext.<ext> = <language>. CLI flags");
    println("  override the config.");
    return EXIT_OK;
}

# Match a long option of the form "--name=VALUE".
# Returns pointer to the VALUE part on match, 0 otherwise.
fn match_eq_flag(arg, name) {
    var nlen = strlen(name);
    if (memeq(arg, name, nlen) == 0) { return 0; }
    if (load8(arg + nlen) != 61) { return 0; }
    return arg + nlen + 1;
}

fn set_color(value) {
    if (streq(value, "auto") == 1)   { g_flag_color = 0 - 1; return 0; }
    if (streq(value, "always") == 1) { g_flag_color = 1;     return 0; }
    if (streq(value, "never") == 1)  { g_flag_color = 0;     return 0; }
    return 1;
}

# Accepts "auto" | "never" | "character". Stored in g_flag_wrap but
# unused by the M5 renderer (the terminal handles visual wrap for all
# three values today). "character" requires TIOCGWINSZ — M8.
fn set_wrap(value) {
    if (streq(value, "auto") == 1)      { g_flag_wrap = 0; return 0; }
    if (streq(value, "never") == 1)     { g_flag_wrap = 1; return 0; }
    if (streq(value, "character") == 1) { g_flag_wrap = 2; return 0; }
    return 1;
}

# --line-range=A:B (1-indexed, inclusive). Either side may be open
# (":B" = 1..B, "A:" = A..end). Single line "A" treated as "A:A".
# Returns 0 on success, 1 on parse error.
fn set_line_range(value) {
    var vlen = strlen(value);
    if (vlen == 0) { return 1; }
    var colon = 0 - 1;
    var k = 0;
    while (k < vlen) {
        if (load8(value + k) == 58) { if (colon < 0) { colon = k; } }
        k = k + 1;
    }
    var a_end = vlen;
    if (colon >= 0) { a_end = colon; }
    var a = _parse_line_no(value, 0, a_end);
    if (a < 0) { return 1; }
    var b = 0;
    if (colon >= 0) {
        b = _parse_line_no(value, colon + 1, vlen);
        if (b < 0) { return 1; }
    } else {
        if (a == 0) { return 1; }
        b = a;
    }
    if (a > 0) { if (b > 0) { if (a > b) { return 1; } } }
    g_line_range_start = a;    # 0 = open
    g_line_range_end = b;      # 0 = open
    return 0;
}

# Digits value[s..e): 0 when empty (an open end), -1 when anything is not
# a digit, when there are more than 18 digits (i64 overflow — 2^64 + 1
# wrapped to line 1; FINDING-010's lesson), or when the value is 0 (lines
# are 1-indexed: `0`, `0:` and `:0` used to mean "unset" and print the
# whole file). Audit 2026-10-31 FINDING-027.
fn _parse_line_no(v, s, e) {
    if (e <= s) { return 0; }
    if (e - s > 18) { return 0 - 1; }
    var n = 0;
    var i = s;
    while (i < e) {
        var c = load8(v + i);
        if (c < 48) { return 0 - 1; }
        if (c > 57) { return 0 - 1; }
        n = n * 10 + (c - 48);
        i = i + 1;
    }
    if (n == 0) { return 0 - 1; }
    return n;
}

# --strip-ansi=auto|always|never. less -R naming for the existing -r
# behavior plus an "always" mode that also strips undecorated piped
# output (never -p, which is cat-identical).
fn set_strip_ansi(value) {
    if (streq(value, "auto") == 1)   { g_flag_strip_ansi = 0; return 0; }
    if (streq(value, "always") == 1) { g_flag_strip_ansi = 1; return 0; }
    if (streq(value, "never") == 1)  { g_flag_strip_ansi = 2; return 0; }
    return 1;
}

# Parse --tabs=N. Rejects negative values. Returns 0 OK, 1 on error.
# --format=<text|ndjson>. Returns 0 OK, 1 on a bad value.
fn set_format(value) {
    if (streq(value, "text") == 1)   { g_flag_format = FORMAT_TEXT;   return 0; }
    if (streq(value, "auto") == 1)   { g_flag_format = FORMAT_TEXT;   return 0; }
    if (streq(value, "ndjson") == 1) { g_flag_format = FORMAT_NDJSON; return 0; }
    return 1;
}

# Write one JSON string body (no surrounding quotes) for buf[s..s+len).
# Escapes exactly what RFC 8259 requires and nothing else: `"` and `\`,
# the two-character forms for \b \f \n \r \t, and \u00XX for every
# other C0 control. Bytes >= 0x80 pass through untouched — they are UTF-8
# continuation/lead bytes and re-encoding them would corrupt the text. This
# is the one place owl writes file bytes into a structured format, so it
# has to be exact: an unescaped control byte here would let file content
# break out of the JSON string and forge a record for whatever consumes it.
fn _ndjson_escape(buf, s, len) {
    var i = 0;
    while (i < len) {
        var c = load8(buf + s + i);
        if (c == 34) { out_write("\\\"", 2); }
        else { if (c == 92) { out_write("\\\\", 2); }
        else { if (c == 8)  { out_write("\\b", 2); }
        else { if (c == 12) { out_write("\\f", 2); }
        else { if (c == 10) { out_write("\\n", 2); }
        else { if (c == 13) { out_write("\\r", 2); }
        else { if (c == 9)  { out_write("\\t", 2); }
        else { if (c < 32) {
                    # \u00XX — the only remaining C0 shapes.
                    out_write("\\u00", 4);
                    var hi = c / 16;
                    var lo = c % 16;
                    _ndjson_hex_digit(hi);
                    _ndjson_hex_digit(lo);
                } else {
                    if (c == 127) { out_write("\\u007f", 6); }
                    else {
                        if (c < 128) { out_write(buf + s + i, 1); }
                        else {
                            # A well-formed UTF-8 sequence passes through
                            # untouched; anything else is not valid JSON
                            # text, so it becomes U+FFFD (audit 2026-10-31).
                            var sl = _utf8_seq_len(buf, s + i, s + len);
                            if (sl == 0) { out_write("\\ufffd", 6); }
                            else {
                                out_write(buf + s + i, sl);
                                i = i + sl - 1;
                            }
                        }
                    }
                } } } } } } } }
        i = i + 1;
    }
    return 0;
}

# Length of the well-formed UTF-8 sequence that starts at buf[p] (a byte
# >= 0x80) and ends before `end`, or 0 when it is not one: a stray
# continuation byte, an overlong form, a surrogate, a value past U+10FFFF,
# or a sequence the token boundary cuts short (RFC 3629 §4).
fn _utf8_seq_len(buf, p, end) {
    var c = load8(buf + p);
    var n = 0;
    if (c >= 0xC2) { if (c <= 0xDF) { n = 2; } }
    if (c >= 0xE0) { if (c <= 0xEF) { n = 3; } }
    if (c >= 0xF0) { if (c <= 0xF4) { n = 4; } }
    if (n == 0) { return 0; }
    if (p + n > end) { return 0; }
    var lo = 0x80;
    var hi = 0xBF;
    if (c == 0xE0) { lo = 0xA0; }
    if (c == 0xED) { hi = 0x9F; }
    if (c == 0xF0) { lo = 0x90; }
    if (c == 0xF4) { hi = 0x8F; }
    var b1 = load8(buf + p + 1);
    if (b1 < lo) { return 0; }
    if (b1 > hi) { return 0; }
    var k = 2;
    while (k < n) {
        var b = load8(buf + p + k);
        if (b < 0x80) { return 0; }
        if (b > 0xBF) { return 0; }
        k = k + 1;
    }
    return n;
}

fn _ndjson_hex_digit(v) {
    var d[1];
    if (v < 10) { store8(&d, 48 + v); } else { store8(&d, 87 + v); }
    out_write(&d, 1);
    return 0;
}

# Emit the tokenbuf as newline-delimited JSON, one object per token:
#
#   {"kind":"keyword","start":0,"len":2,"line":1,"text":"fn"}
#
# `kind`/`start`/`len` are exactly vyakarana's own `vyk --ndjson` shape, so
# a consumer written against that keeps working; `line` and `text` are
# owl's additions — a viewer's consumers want to locate and display a span,
# which is the whole reason to ask owl rather than vyakarana.
#
# `line` is 1-based and counted over the buffer, so it matches what the
# gutter would have printed for the same file.
fn _emit_ndjson(buf, n, tb) {
    if (tb == 0) { return 0 - 1; }
    var count = tokenbuf_count(tb);
    var i = 0;
    # Running line number: advance the scan cursor to each token's start,
    # counting newlines on the way. Tokens are in ascending start order, so
    # one forward pass over the buffer covers every token.
    var scan = 0;
    var line = 1;
    while (i < count) {
        var k = tokenbuf_kind(tb, i);
        var st = tokenbuf_start(tb, i);
        var ln = tokenbuf_len(tb, i);
        # Defensive: a token span outside the buffer would read OOB. The
        # tokenizer should never produce one, but this is the boundary
        # between owl and a dep, and owl does not get to assume.
        if (st < 0)      { st = 0; }
        if (st > n)      { st = n; }
        if (ln < 0)      { ln = 0; }
        if (st + ln > n) { ln = n - st; }
        while (scan < st) {
            if (load8(buf + scan) == 10) { line = line + 1; }
            scan = scan + 1;
        }
        out_write("{\"kind\":\"", 9);
        var name = kind_name(k);
        out_write(name, strlen(name));
        out_write("\",\"start\":", 10);
        out_int(st);
        out_write(",\"len\":", 7);
        out_int(ln);
        out_write(",\"line\":", 8);
        out_int(line);
        out_write(",\"text\":\"", 9);
        _ndjson_escape(buf, st, ln);
        out_write("\"}\n", 3);
        i = i + 1;
    }
    return 0;
}

# Audit FINDING-010: this accepted any digit string. `--tabs=` or a
# `tabs =` config line with a huge value made every literal TAB expand
# into that many spaces — a wedged process (or an unbounded write when
# stdout is a file) from a value that cannot mean anything useful. A tab
# stop wider than a terminal is already nonsense; TABS_MAX is generous.
var TABS_MAX = 64;

fn set_tabs(value) {
    var vlen = strlen(value);
    if (vlen == 0) { return 1; }
    # Reject before atoi() rather than after: a long digit run overflows
    # i64 inside atoi and could wrap to something that passes a range
    # check applied to the result.
    if (vlen > 3) { return 1; }
    var p = 0;
    while (p < vlen) {
        var c = load8(value + p);
        if (c < 48) { return 1; }
        if (c > 57) { return 1; }
        p = p + 1;
    }
    var t = atoi(value);
    if (t < 0)         { return 1; }
    if (t > TABS_MAX)  { return 1; }
    g_flag_tabs = t;
    return 0;
}

# Pager gate — uses is_tty (local) and g_flag_plain (local); reads
# g_flag_paging from pager.cyr. Kept here so pager.cyr stays
# dependency-free of main.
fn should_page() {
    if (g_flag_plain == 1) { return 0; }
    # ndjson is machine output and --follow has no end to page to.
    if (g_flag_format == FORMAT_NDJSON) { return 0; }
    if (g_flag_follow == 1) { return 0; }
    if (g_flag_paging == 0) { return 0; }
    if (is_tty(STDOUT) == 0) { return 0; }
    return 1;
}

fn main() {
    alloc_init();
    # The stdlib reads argv from /proc/self/cmdline. Without /proc (a
    # chroot, a container, fd exhaustion) every argument was silently
    # dropped and owl read stdin instead (audit 2026-10-31 FINDING-038).
    if (args_init() < 0) {
        eprint("owl: cannot read the command line\n", 34);
        return EXIT_USAGE;
    }
    # Config → env → CLI: read the file first so CLI flags parsed
    # below always win. Missing file is a silent no-op.
    config_load();

    var n = argc();
    # Two passes. Pass 1 parses and validates every flag and collects the
    # positional arguments; pass 2 renders them. Through 1.5.2 this was one
    # loop that rendered each file as it was reached, so a flag after a file
    # half-applied (`owl a.c -p b.c` highlighted b.c — -p no longer cat-
    # identical; `--color=never` after a file was ignored), `owl FILE
    # --bogus` rendered FILE before exiting 2 and orphaned the pager, and
    # `owl missing.txt -V` threw the failure away (audit 2026-10-31
    # FINDING-024). Every flag now applies to every file.
    var pos = alloc((n + 1) * 8);
    if (pos == 0) {
        eprint("owl: out of memory\n", 19);
        return EXIT_USAGE;
    }
    var npos = 0;

    var i = 1;
    while (i < n) {
        var a = argv(i);

        if (streq(a, "-V") == 1) {
            var k = i + 1;
            while (k < n) {
                var ak = argv(k);
                if (streq(ak, "--verbose") == 1) { g_flag_verbose = 1; }
                if (streq(ak, "-v") == 1)        { g_flag_verbose = 1; }
                k = k + 1;
            }
            return print_version();
        }
        if (streq(a, "--version") == 1) {
            var k = i + 1;
            while (k < n) {
                var ak = argv(k);
                if (streq(ak, "--verbose") == 1) { g_flag_verbose = 1; }
                if (streq(ak, "-v") == 1)        { g_flag_verbose = 1; }
                k = k + 1;
            }
            return print_version();
        }
        if (streq(a, "-h") == 1)        { return print_help(); }
        if (streq(a, "--help") == 1)    { return print_help(); }

        if (streq(a, "--list-themes") == 1)    { return print_theme_list(); }
        if (streq(a, "--list-languages") == 1) { return print_language_list(); }

        if (streq(a, "-n") == 1)         { g_flag_numbers = 1; i = i + 1; continue; }
        if (streq(a, "--number") == 1)   { g_flag_numbers = 1; i = i + 1; continue; }
        if (streq(a, "-N") == 1)         { g_flag_numbers = 0; i = i + 1; continue; }
        if (streq(a, "--no-number") == 1) { g_flag_numbers = 0; i = i + 1; continue; }
        if (streq(a, "-p") == 1)         { g_flag_plain = 1; i = i + 1; continue; }
        if (streq(a, "--plain") == 1)    { g_flag_plain = 1; i = i + 1; continue; }
        if (streq(a, "-A") == 1)         { g_flag_show_all = 1; i = i + 1; continue; }
        if (streq(a, "--show-all") == 1) { g_flag_show_all = 1; i = i + 1; continue; }
        if (streq(a, "-v") == 1)         { g_flag_verbose = 1; i = i + 1; continue; }
        if (streq(a, "--verbose") == 1)  { g_flag_verbose = 1; i = i + 1; continue; }
        if (streq(a, "-x") == 1)         { g_flag_hex = 1; i = i + 1; continue; }
        if (streq(a, "--hex") == 1)      { g_flag_hex = 1; i = i + 1; continue; }
        if (streq(a, "--diff") == 1)     { g_flag_diff = 1; i = i + 1; continue; }
        if (streq(a, "-f") == 1)         { g_flag_follow = 1; i = i + 1; continue; }
        if (streq(a, "--follow") == 1)   { g_flag_follow = 1; i = i + 1; continue; }
        if (streq(a, "-r") == 1)                     { g_flag_raw_controls = 1; i = i + 1; continue; }
        if (streq(a, "--raw-control-chars") == 1)    { g_flag_raw_controls = 1; i = i + 1; continue; }

        var v = match_eq_flag(a, "--color");
        if (v != 0) {
            if (set_color(v) != 0) {
                report_error(a, "invalid value (want auto|always|never)");
                return EXIT_USAGE;
            }
            i = i + 1;
            continue;
        }
        v = match_eq_flag(a, "--paging");
        if (v != 0) {
            if (set_paging(v) != 0) {
                report_error(a, "invalid value (want auto|always|never)");
                return EXIT_USAGE;
            }
            i = i + 1;
            continue;
        }
        v = match_eq_flag(a, "--style");
        if (v != 0) {
            if (set_style(v) != 0) {
                report_error(a, "invalid value (want auto|changes|no-changes)");
                return EXIT_USAGE;
            }
            i = i + 1;
            continue;
        }
        v = match_eq_flag(a, "--theme");
        if (v != 0) {
            var tidx = theme_index(v);
            if (tidx < 0) {
                report_error(a, "unknown theme (try --list-themes)");
                return EXIT_USAGE;
            }
            g_active_theme = tidx;
            i = i + 1;
            continue;
        }
        v = match_eq_flag(a, "--language");
        if (v != 0) {
            if (lang_is_valid(v) == 0) {
                report_error(a, "unknown language (try --list-languages)");
                return EXIT_USAGE;
            }
            g_flag_lang = v;
            i = i + 1;
            continue;
        }
        v = match_eq_flag(a, "--format");
        if (v != 0) {
            if (set_format(v) != 0) {
                eprint("owl: invalid --format (want text or ndjson)\n", 44);
                return 2;
            }
            i = i + 1;
            continue;
        }

        v = match_eq_flag(a, "--tabs");
        if (v != 0) {
            if (set_tabs(v) != 0) {
                report_error(a, "invalid value (want a non-negative integer)");
                return EXIT_USAGE;
            }
            i = i + 1;
            continue;
        }
        v = match_eq_flag(a, "--wrap");
        if (v != 0) {
            if (set_wrap(v) != 0) {
                report_error(a, "invalid value (want auto|never|character)");
                return EXIT_USAGE;
            }
            i = i + 1;
            continue;
        }
        v = match_eq_flag(a, "--strip-ansi");
        if (v != 0) {
            if (set_strip_ansi(v) != 0) {
                report_error(a, "invalid value (want auto|always|never)");
                return EXIT_USAGE;
            }
            i = i + 1;
            continue;
        }
        v = match_eq_flag(a, "--line-range");
        if (v != 0) {
            if (set_line_range(v) != 0) {
                report_error(a, "invalid value (want A:B, A:, :B, or A)");
                return EXIT_USAGE;
            }
            i = i + 1;
            continue;
        }

        if (streq(a, "-") == 1) {
            store64(pos + npos * 8, i);
            npos = npos + 1;
            i = i + 1;
            continue;
        }

        if (load8(a) == 45) {
            report_error(a, "unknown option");
            return EXIT_USAGE;
        }

        store64(pos + npos * 8, i);
        npos = npos + 1;
        i = i + 1;
    }

    # --follow tails one regular file: with several, the first never ended
    # and the rest were never shown; on stdin it was silently not followed.
    if (g_flag_follow == 1) {
        var fok = 0;
        if (npos == 1) {
            if (streq(argv(load64(pos)), "-") == 0) { fok = 1; }
        }
        if (fok == 0) {
            report_error("--follow", "needs exactly one file (not stdin)");
            return EXIT_USAGE;
        }
    }

    if (npos == 0) {
        if (is_tty(STDIN) == 1) { return print_help(); }
        resolve_mode();
        if (should_page() == 1) { start_pager(); }
        g_err_reported = 0;
        var bare_rc = render_fd(STDIN, "<stdin>");
        if (bare_rc < 0) {
            if (g_err_reported == 0) { report_error("<stdin>", _errno_msg(g_read_errno)); }
        }
        emit_footer();
        stop_pager();
        if (bare_rc < 0) { return EXIT_ALL_FAIL; }
        return EXIT_OK;
    }

    # Pass 2: render.
    resolve_mode();
    if (should_page() == 1) { start_pager(); }
    var ok = 0;
    var fail = 0;
    var k = 0;
    while (k < npos) {
        var pa = argv(load64(pos + k * 8));
        var rc = 0;
        g_err_reported = 0;
        g_read_errno = 0;
        if (streq(pa, "-") == 1) { rc = render_fd(STDIN, "<stdin>"); }
        else { rc = render_path(pa); }
        if (rc < 0) {
            if (g_err_reported == 0) {
                var shown = pa;
                if (streq(pa, "-") == 1) { shown = "<stdin>"; }
                report_error(shown, _errno_msg(g_read_errno));
            }
        }
        emit_footer();
        out_flush();
        if (rc < 0) { fail = fail + 1; } else { ok = ok + 1; }
        k = k + 1;
    }

    var exit_code = EXIT_OK;
    if (ok == 0) { if (fail > 0) { exit_code = EXIT_ALL_FAIL; } }
    if (exit_code == EXIT_OK) {
        if (fail > 0) { exit_code = EXIT_PARTIAL; }
    }
    stop_pager();
    return exit_code;
}

# Entry: a BARE top-level call (NOT a module-scope `var r = main()`). On agnos a
# module-scope `var r = main()` runs main during gvar-init — BEFORE cycc emits the
# init-rsp capture (placed after gvar-inits as of cyrius 6.1.14) — so argc()/argv()
# read 0/null and `owl FILE` saw no positional, printing its help. A bare statement
# runs in PARSE_PROG, after the capture, so args resolve. SYS_EXIT is 0 on agnos /
# 60 on Linux (per-target), so this form is correct on host AND agnos.
fn _owl_entry(): i64 {
    var r = main();
    out_flush();
    syscall(SYS_EXIT, r);
    return 0;
}
_owl_entry();
