# src/lang.cyr — language routing (M3a; vyakarana's routes since 1.6.0)
#
# owl decides which grammar a file gets; vyakarana owns the grammars and,
# since 1.6.0, the routes too. `_owl_detect` tries, in order:
#
#   1. `ext.<x> = <lang>` overrides from the config — the user's explicit
#      choice, so they win;
#   2. a user grammar with a NEW name (one that replaces no bundled grammar),
#      by what it declares (`extensions` / `filenames` / `shebangs`), through
#      vyakarana's `detect_language_registered`. Installing it is the user's
#      choice too, so it may claim an extension a bundled grammar routes —
#      unless a bundled grammar declares a longer match (`.d.ts` over
#      `.ts`). A grammar that replaces a bundled one by name changes how that
#      language highlights, not which files route to it, so the content votes
#      in step 3 keep working. Skipped when no such grammar is installed: it
#      needs the registry loaded;
#   3. vyakarana's `detect_language_combined` — its compiled route table for
#      the bundled grammars (extensions, filenames such as `Dockerfile` /
#      `GNUmakefile`, shebangs incl. CRLF and tab forms) plus content votes:
#      `.s` picks x86-64 or AArch64, `.asm` picks NASM or GNU as. It needs no
#      grammar loaded, so routing stays cheap;
#   4. owl's supplement — the routes owl 1.5.3 had and vyakarana 2.10.0 does
#      not (`_owl_supplement`). Each is an upstream gap
#      (vyakarana/docs/development/issues/2026-10-31-vyakarana-missing-routes.md); the
#      table shrinks as vyakarana gains them and goes when it is empty;
#   5. owl's own opening sniff (1.1.4): JSON / YAML / TOML / markdown.
#
# Through 1.5.3 owl routed through three hand-kept tables of its own. A
# grammar bundled but missing from them was unreachable (markdown, until
# 1.5.2), `.asm` could not get vyakarana's NASM / GNU-as vote, and every
# vyakarana grammar drop meant editing them in lockstep.
#
# Usage from main.cyr:
#   _owl_detect(path, first_buf, first_n) → "rust" | … | "plain"
#   lang_is_valid("rust")                  → 1 / 0   (registry, or "plain")
#   print_language_list()

# ── Helpers ────────────────────────────────────────────────────────────

# Case-folded suffix check: does `path` end with `ext` (lowercase)?
# Path chars are compared lowercase via add-32-if-A-to-Z trick.
fn _path_ends_with_lower(path, ext) {
    var plen = strlen(path);
    var elen = strlen(ext);
    if (elen > plen) { return 0; }
    var pi = plen - elen;
    var ei = 0;
    while (ei < elen) {
        var pc = load8(path + pi + ei);
        var ec = load8(ext + ei);
        if (pc >= 65) { if (pc <= 90) { pc = pc + 32; } }
        if (pc != ec) { return 0; }
        ei = ei + 1;
    }
    return 1;
}

# 1 when the last path component starts with '.' (a dotfile: .bashrc,
# .gitignore, .env …).
fn _path_is_dotfile(path) {
    if (path == 0) { return 0; }
    var n = strlen(path);
    var i = n;
    while (i > 0) {
        if (load8(path + i - 1) == 47) { i = 0 - i; continue; }
        i = i - 1;
    }
    var start = 0;
    if (i < 0) { start = 0 - i; }
    if (start >= n) { return 0; }
    if (load8(path + start) == 46) { return 1; }
    return 0;
}

# ── Public API ─────────────────────────────────────────────────────────

# 1 when `name` is a language owl can render: "plain", or any grammar in
# vyakarana's registry — the bundled set and the user's overlay alike.
# Loads the registry on first use (_owl_has_grammar), so validating
# `--language` / `ext.<x>` costs one grammar bootstrap.
fn lang_is_valid(name) {
    if (name == 0) { return 0; }
    if (streq(name, "plain") == 1) { return 1; }
    if (_owl_has_grammar(name) == 1) { return 1; }
    return 0;
}

# ── Config-driven extension overrides (1.1.1) ─────────────────────────
# Up to 16 user-defined `ext.<extension> = <language>` entries from
# config.cyml. Entries are registered before CLI parsing and consulted
# FIRST by _owl_detect — so a user can map .conf → shell without forking a
# grammar.

var USER_EXT_MAX = 16;
var g_user_ext_count = 0;
var g_user_ext_keys  = 0;   # alloc'd lazily: USER_EXT_MAX * 8 bytes
var g_user_ext_langs = 0;   # alloc'd lazily: USER_EXT_MAX * 8 bytes (name copies)

fn _user_ext_init() {
    if (g_user_ext_keys == 0) {
        g_user_ext_keys  = alloc(USER_EXT_MAX * 8);
        g_user_ext_langs = alloc(USER_EXT_MAX * 8);
        # FINDING-011 — lang_register_ext_override stores through both.
        if (g_user_ext_keys == 0)  { return 1; }
        if (g_user_ext_langs == 0) { g_user_ext_keys = 0; return 1; }
    }
    return 0;
}

# A heap copy of NUL-terminated `s`, or 0.
fn _lang_strdup(s) {
    var n = strlen(s);
    var d = alloc(n + 1);
    if (d == 0) { return 0; }
    memcpy(d, s, n);
    store8(d + n, 0);
    return d;
}

# Register one ext→lang override. Returns 0 OK, 1 if the table is full
# (USER_EXT_MAX distinct extensions), 2 if the language name is unknown,
# the extension is empty, or memory ran out. Called by config.cyr after
# key parsing; config.cyr owns the messages for these codes.
#
# The extension is stored normalised — leading dot added, A-Z folded to
# a-z — because the lookup folds only the PATH side. Registering an
# extension that is already present replaces its language in place (every
# config key is last-wins) and does not use up a slot. The language is
# stored as a heap copy of its name: `lang` points into the config
# parser's scratch buffer, which the next line reuses (the 1.5.3
# dangling-theme-name lesson), and since 1.6.0 there is no index table to
# store a number from.
fn lang_register_ext_override(ext, lang) {
    if (lang_is_valid(lang) == 0) { return 2; }

    var elen = strlen(ext);
    if (elen == 0) { return 2; }

    if (_user_ext_init() != 0) { return 2; }   # FINDING-011

    # Normalize: prepend a leading dot if the user didn't include one
    # ("conf" → ".conf"), and fold to lowercase.
    var dot = 0;
    if (load8(ext) != 46) { dot = 1; }
    var copy = alloc(elen + dot + 1);
    if (copy == 0) { return 2; }   # FINDING-011
    var off = 0;
    if (dot == 1) {
        store8(copy + off, 46);
        off = off + 1;
    }
    var k = 0;
    while (k < elen) {
        var c = load8(ext + k);
        if (c >= 65) { if (c <= 90) { c = c + 32; } }
        store8(copy + off, c);
        off = off + 1;
        k = k + 1;
    }
    store8(copy + off, 0);

    var lname = _lang_strdup(lang);
    if (lname == 0) { return 2; }   # FINDING-011

    var ui = 0;
    while (ui < g_user_ext_count) {
        if (streq(load64(g_user_ext_keys + ui * 8), copy) == 1) {
            store64(g_user_ext_langs + ui * 8, lname);
            return 0;
        }
        ui = ui + 1;
    }

    if (g_user_ext_count >= USER_EXT_MAX) { return 1; }
    store64(g_user_ext_keys  + g_user_ext_count * 8, copy);
    store64(g_user_ext_langs + g_user_ext_count * 8, lname);
    g_user_ext_count = g_user_ext_count + 1;
    return 0;
}

# The user's override for `path`, or 0.
fn _user_ext_lookup(path) {
    var ui = 0;
    while (ui < g_user_ext_count) {
        if (_path_ends_with_lower(path, load64(g_user_ext_keys + ui * 8)) == 1) {
            return load64(g_user_ext_langs + ui * 8);
        }
        ui = ui + 1;
    }
    return 0;
}

# ── owl's supplement (1.6.0) ───────────────────────────────────────────
# Routes owl 1.5.3's own tables had that vyakarana 2.10.0's do not. Keeping
# them means moving to vyakarana's routes regresses no file. Filed upstream
# (vyakarana/docs/development/issues/2026-10-31-vyakarana-missing-routes.md); delete
# each row when vyakarana routes it, and the table when it is empty.

# Interpreter word → language. A word matches when it starts with the entry
# and the rest is digits or dots (`ocaml4.14`), as vyakarana's prefix match
# allows `python3`.
fn _supp_interp_lang(w, wl) {
    if (_supp_word_is(w, wl, "deno") == 1)        { return "javascript"; }
    if (_supp_word_is(w, wl, "rust-script") == 1) { return "rust"; }
    if (_supp_word_is(w, wl, "swift") == 1)       { return "swift"; }
    if (_supp_word_is(w, wl, "elixir") == 1)      { return "elixir"; }
    if (_supp_word_is(w, wl, "ocamlrun") == 1)    { return "ocaml"; }
    if (_supp_word_is(w, wl, "ocaml") == 1)       { return "ocaml"; }
    return 0;
}

fn _supp_word_is(w, wl, name) {
    var nl = strlen(name);
    if (wl < nl) { return 0; }
    if (memeq(w, name, nl) == 0) { return 0; }
    var i = nl;
    while (i < wl) {
        var c = load8(w + i);
        var ok = 0;
        if (c == 46) { ok = 1; }
        if (c >= 48) { if (c <= 57) { ok = 1; } }
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# 1 when byte c separates shebang words (space or tab, as the kernel's
# parser treats them).
fn _supp_is_sep(c) {
    if (c == 32) { return 1; }
    if (c == 9) { return 1; }
    return 0;
}

# The language a `#!` line's interpreter names, or 0. The interpreter is the
# basename of the first word; for `env` it is the first later word that is
# not an option (`env -S deno run`). The line ends at LF, CR or byte 256.
fn _supp_shebang(buf, n) {
    if (n < 3) { return 0; }
    if (load8(buf) != 35) { return 0; }
    if (load8(buf + 1) != 33) { return 0; }
    var end = n;
    if (end > 256) { end = 256; }
    var i = 2;
    var stop = 0;
    while (stop == 0) {
        if (i >= end) { stop = 1; continue; }
        var c = load8(buf + i);
        if (c == 10) { stop = 1; continue; }
        if (c == 13) { stop = 1; continue; }
        i = i + 1;
    }
    end = i;
    var pos = 2;
    var first = 1;
    while (pos < end) {
        while (pos < end) {
            if (_supp_is_sep(load8(buf + pos)) == 0) { break; }
            pos = pos + 1;
        }
        if (pos >= end) { return 0; }
        var ws = pos;
        while (pos < end) {
            if (_supp_is_sep(load8(buf + pos)) == 1) { break; }
            pos = pos + 1;
        }
        # basename: the word after its last '/'
        var bs = ws;
        var k = ws;
        while (k < pos) {
            if (load8(buf + k) == 47) { bs = k + 1; }
            k = k + 1;
        }
        var bl = pos - bs;
        var skip = 0;
        if (first == 1) {
            if (bl == 3) { if (memeq(buf + bs, "env", 3) == 1) { skip = 1; } }
        } else {
            if (load8(buf + ws) == 45) { skip = 1; }   # an env option
        }
        if (skip == 0) { return _supp_interp_lang(buf + bs, bl); }
        first = 0;
    }
    return 0;
}

# The supplement's language for `path` / its first `n` bytes, or 0.
fn _owl_supplement(path, buf, n) {
    if (path != 0) {
        if (_path_ends_with_lower(path, ".tcyr") == 1) { return "cyrius"; }
        if (_path_ends_with_lower(path, ".bcyr") == 1) { return "cyrius"; }
        if (_path_ends_with_lower(path, ".fcyr") == 1) { return "cyrius"; }
    }
    if (buf != 0) { return _supp_shebang(buf, n); }
    return 0;
}

# ── Routing ────────────────────────────────────────────────────────────

# The language for a file: `path` and its first `n` bytes (`buf`). See the
# header for the order. Never 0.
fn _owl_detect(path, buf, n) {
    var u = _user_ext_lookup(path);
    if (u != 0) { return u; }
    if (_owl_overlay_new_count() > 0) {
        var r = detect_language_registered(path, buf, n);
        if (r != 0) {
            if (_owl_overlay_is_new(r) == 1) { return r; }
        }
    }
    var c = detect_language_combined(path, buf, n);
    if (c != 0) { return c; }
    var x = _owl_supplement(path, buf, n);
    if (x != 0) { return x; }
    var s = _owl_detect_language_from_content(buf, n, path);
    if (s != 0) { return s; }
    return "plain";
}

# Content-based detection (1.1.4). Conservative anchored patterns
# for file-format languages where the opening bytes are highly
# diagnostic. Programming languages are intentionally NOT detected
# this way — false-positive risk is too high for the small payoff
# (vyakarana's shebang and signature sniffs run before this).
# Returns a language name or 0 (no match).
#
# Recognized openings:
#   "{" / "[" non-alpha → json     (TOML section [name] disambiguates)
#   "---" at file start → yaml
#   "# " / "## "        → markdown, except in a dotfile: `.bashrc`,
#                          `.gitignore` and friends open with `# ` comments
#                          and were drawn as markdown (audit INFO-013)
fn _is_alpha_or_underscore(c) {
    if (c == 95) { return 1; }              # _
    if (c >= 65) { if (c <= 90)  { return 1; } }
    if (c >= 97) { if (c <= 122) { return 1; } }
    return 0;
}

# Renamed at 1.3.1 — vyakarana 2.x exports its own
# `detect_language_from_content(src, src_len)`, and the duplicate
# triggered a "last definition wins" warning the CI lint gate caught.
# owl's content detection stays under the `_owl_*` convention.
fn _owl_detect_language_from_content(buf, n, path) {
    if (n <= 0) { return 0; }
    # Skip leading blank lines + whitespace.
    var i = 0;
    var go = 1;
    while (go == 1) {
        if (i >= n) { go = 0; continue; }
        var c = load8(buf + i);
        if (c == 32) { i = i + 1; continue; }
        if (c == 9)  { i = i + 1; continue; }
        if (c == 10) { i = i + 1; continue; }
        if (c == 13) { i = i + 1; continue; }
        go = 0;
    }
    if (i >= n) { return 0; }

    var c0 = load8(buf + i);

    # JSON: first non-whitespace is "{" — high confidence.
    if (c0 == 123) { return "json"; }   # {

    # "[" is JSON array OR TOML section. Peek next non-space char.
    if (c0 == 91) {                     # [
        if (i + 1 < n) {
            var c1 = load8(buf + i + 1);
            if (_is_alpha_or_underscore(c1) == 1) { return "toml"; }
        }
        return "json";
    }

    # YAML: "---" at start of first non-blank line (document separator).
    if (c0 == 45) {                     # -
        if (i + 2 < n) {
            if (load8(buf + i + 1) == 45) {
                if (load8(buf + i + 2) == 45) {
                    return "yaml";
                }
            }
        }
    }

    # Markdown: ATX header "# " or "## ..." — not in a dotfile.
    if (c0 == 35) {                     # #
        if (_path_is_dotfile(path) == 0) {
            if (i + 1 < n) {
                var c2 = load8(buf + i + 1);
                if (c2 == 32) { return "markdown"; }
                if (c2 == 35) { return "markdown"; }
            }
        }
    }

    return 0;
}

# Every language owl can render: "plain", then the registry's grammar
# names — bundled and user overlay — sorted and de-duplicated (a user
# grammar that overrides a bundled one by name is listed once).
fn print_language_list() {
    _owl_bootstrap_grammars();
    var reg = registry_init();
    var total = vec_len(reg);
    var names = alloc((total + 1) * 8);
    if (names == 0) { println("plain"); return 0; }
    var cnt = 0;
    var i = 0;
    while (i < total) {
        var nm = grammar_name(vec_get(reg, i));
        var dup = 0;
        var j = 0;
        while (j < cnt) {
            if (streq(load64(names + j * 8), nm) == 1) { dup = 1; j = cnt; continue; }
            j = j + 1;
        }
        if (dup == 0) {
            # Insertion sort: shift larger names right, then place.
            var k = cnt;
            var placing = 1;
            while (placing == 1) {
                if (k == 0) { placing = 0; continue; }
                var prev = load64(names + (k - 1) * 8);
                if (_lang_cmp(prev, nm) <= 0) { placing = 0; continue; }
                store64(names + k * 8, prev);
                k = k - 1;
            }
            store64(names + k * 8, nm);
            cnt = cnt + 1;
        }
        i = i + 1;
    }
    println("plain");
    var p = 0;
    while (p < cnt) {
        println(load64(names + p * 8));
        p = p + 1;
    }
    return 0;
}

# strcmp-style byte comparison of two NUL-terminated names.
fn _lang_cmp(a, b) {
    var i = 0;
    var go = 1;
    while (go == 1) {
        var ca = load8(a + i);
        var cb = load8(b + i);
        if (ca != cb) { return ca - cb; }
        if (ca == 0) { return 0; }
        i = i + 1;
    }
    return 0;
}
