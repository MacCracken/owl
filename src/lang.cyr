# src/lang.cyr — language detection (M3a)
#
# Extension table + shebang peek. Stores a detected-language name for
# the current file; actual token-level coloring lands in M3b.
#
# Design:
#   - lang table is a flat array of {name, extensions, shebang_hints}
#   - extensions are matched case-sensitive against the file suffix
#   - shebang peek reads the first 128 bytes and looks for "#!"
#   - unknown/missing input falls through to "plain"
#
# Usage from main.cyr:
#   include "src/lang.cyr"
#   lang_init();
#   detect_language_from_path("foo.py")  → "python"
#   detect_language_from_shebang(buf, n) → "shell" | ... | 0
#   lang_is_valid("rust")                → 1 / 0
#   print_language_list()

# ── Table ──────────────────────────────────────────────────────────────
# One language per row, as three parallel constants, joined by index.
# Extensions and shebang hints are space-separated lowercase tokens.
# Order matters: "cyrius" precedes "c" so *.cyr doesn't match *.c.

var LANG_COUNT = 41;

# Indexed 0..LANG_COUNT-1
fn lang_name(i) {
    if (i == 0)  { return "plain"; }
    if (i == 1)  { return "shell"; }
    if (i == 2)  { return "python"; }
    if (i == 3)  { return "javascript"; }
    if (i == 4)  { return "typescript"; }
    if (i == 5)  { return "rust"; }
    if (i == 6)  { return "cyrius"; }
    if (i == 7)  { return "c"; }
    if (i == 8)  { return "toml"; }
    if (i == 9)  { return "json"; }
    if (i == 10) { return "yaml"; }
    if (i == 11) { return "go"; }
    if (i == 12) { return "zig"; }
    if (i == 13) { return "asm_x86_64"; }
    if (i == 14) { return "asm_aarch64"; }
    if (i == 15) { return "java"; }
    if (i == 16) { return "kotlin"; }
    if (i == 17) { return "cpp"; }
    if (i == 18) { return "csharp"; }
    if (i == 19) { return "php"; }
    if (i == 20) { return "ruby"; }
    if (i == 21) { return "lua"; }
    if (i == 22) { return "swift"; }
    if (i == 23) { return "elixir"; }
    if (i == 24) { return "ocaml"; }
    if (i == 25) { return "haskell"; }
    if (i == 26) { return "sql"; }
    if (i == 27) { return "graphql"; }
    if (i == 28) { return "protobuf"; }
    if (i == 29) { return "html"; }
    if (i == 30) { return "xml"; }
    if (i == 31) { return "css"; }
    if (i == 32) { return "scss"; }
    if (i == 33) { return "dockerfile"; }
    if (i == 34) { return "makefile"; }
    if (i == 35) { return "ini"; }
    if (i == 36) { return "cyml"; }
    if (i == 37) { return "llvm_ir"; }
    if (i == 38) { return "powershell"; }
    if (i == 39) { return "crystal"; }
    if (i == 40) { return "julia"; }
    return "plain";
}

# Extensions for language i (space-separated, lowercase, leading dot).
# Empty string = language has no extension dispatch (asm_aarch64 needs
# --language=, dockerfile + makefile dispatch via _path_filename_match
# below).
fn lang_exts(i) {
    if (i == 0)  { return ""; }
    if (i == 1)  { return ".sh .bash .zsh"; }
    if (i == 2)  { return ".py"; }
    if (i == 3)  { return ".js .mjs .cjs"; }
    if (i == 4)  { return ".ts"; }
    if (i == 5)  { return ".rs"; }
    if (i == 6)  { return ".cyr .tcyr .bcyr .fcyr"; }
    if (i == 7)  { return ".c .h"; }
    if (i == 8)  { return ".toml"; }
    if (i == 9)  { return ".json"; }
    if (i == 10) { return ".yaml .yml"; }
    if (i == 11) { return ".go"; }
    if (i == 12) { return ".zig"; }
    if (i == 13) { return ".s .asm"; }
    if (i == 14) { return ""; }
    if (i == 15) { return ".java"; }
    if (i == 16) { return ".kt .kts"; }
    if (i == 17) { return ".cpp .cc .cxx .hpp .hxx"; }
    if (i == 18) { return ".cs .csx"; }
    if (i == 19) { return ".php .phtml"; }
    if (i == 20) { return ".rb"; }
    if (i == 21) { return ".lua"; }
    if (i == 22) { return ".swift"; }
    if (i == 23) { return ".ex .exs"; }
    if (i == 24) { return ".ml .mli"; }
    if (i == 25) { return ".hs .lhs"; }
    if (i == 26) { return ".sql"; }
    if (i == 27) { return ".graphql .gql"; }
    if (i == 28) { return ".proto"; }
    if (i == 29) { return ".html .htm"; }
    if (i == 30) { return ".xml .xsl .xsd .svg"; }
    if (i == 31) { return ".css"; }
    if (i == 32) { return ".scss .sass"; }
    if (i == 33) { return ""; }
    if (i == 34) { return ""; }
    if (i == 35) { return ".ini .conf .cfg .properties"; }
    if (i == 36) { return ".cyml"; }
    if (i == 37) { return ".ll"; }
    if (i == 38) { return ".ps1 .psm1 .psd1"; }
    if (i == 39) { return ".cr"; }
    if (i == 40) { return ".jl"; }
    return "";
}

# Shebang interpreter hints for language i (space-separated tokens
# that may appear in the shebang line, e.g. "python" matches
# "#!/usr/bin/env python3").
fn lang_shebangs(i) {
    if (i == 1)  { return "sh bash zsh"; }
    if (i == 2)  { return "python python3 python2"; }
    if (i == 3)  { return "node deno"; }
    if (i == 5)  { return "rust-script"; }
    if (i == 19) { return "php"; }
    if (i == 20) { return "ruby"; }
    if (i == 21) { return "lua"; }
    if (i == 22) { return "swift"; }
    if (i == 23) { return "elixir"; }
    if (i == 24) { return "ocaml ocamlrun"; }
    if (i == 38) { return "pwsh powershell"; }
    return "";
}

# ── Helpers ────────────────────────────────────────────────────────────

# Case-sensitive end-match: does `path` end exactly with `tail`?
# Used by filename-suffix detection (Dockerfile / Containerfile —
# vyakarana 1.8.0 ADR semantics: filename-shape match, not extension).
fn _path_ends_with(path, tail) {
    var plen = strlen(path);
    var tlen = strlen(tail);
    if (tlen > plen) { return 0; }
    var pi = plen - tlen;
    var ti = 0;
    while (ti < tlen) {
        if (load8(path + pi + ti) != load8(tail + ti)) { return 0; }
        ti = ti + 1;
    }
    return 1;
}

# Filename-shape match: returns 1 if `path` is exactly `name`, ends with
# `/<name>`, or ends with `.<name>` (Dockerfile-style suffix per
# vyakarana 1.8.0 — covers ./Dockerfile, /path/to/Dockerfile, and
# name.Dockerfile uniformly).
fn _path_filename_match(path, name) {
    if (_path_ends_with(path, name) == 0) { return 0; }
    var plen = strlen(path);
    var nlen = strlen(name);
    if (plen == nlen) { return 1; }              # exact basename
    var prev = load8(path + plen - nlen - 1);
    if (prev == 47) { return 1; }                # '/' — basename match
    if (prev == 46) { return 1; }                # '.' — name.Dockerfile
    return 0;
}

# Case-folded suffix check: does `path` end with `ext` (lowercase)?
# Path chars are compared lowercase via add-32-if-A-to-Z trick.
fn _path_ends_with_lower(path, ext) {
    var plen = strlen(path);
    var elen = strlen(ext);
    if (elen > plen) { return 0; }
    var pi = plen - elen;
    var ei = 0;
    while (ei < elen) {
        var pc = load8(path + pi + ei);
        var ec = load8(ext + ei);
        if (pc >= 65) { if (pc <= 90) { pc = pc + 32; } }
        if (pc != ec) { return 0; }
        ei = ei + 1;
    }
    return 1;
}

# Does `path` have any of the space-separated extensions in `list`?
fn _path_has_any_ext(path, list) {
    var llen = strlen(list);
    var i = 0;
    while (i < llen) {
        # Skip leading spaces
        while (i < llen) {
            if (load8(list + i) != 32) { break; }
            i = i + 1;
        }
        if (i >= llen) { return 0; }
        # Extract current token into a small buf
        var ebuf[32];
        var ei = 0;
        while (i < llen) {
            if (load8(list + i) == 32) { break; }
            if (ei < 31) {
                store8(&ebuf + ei, load8(list + i));
                ei = ei + 1;
            }
            i = i + 1;
        }
        store8(&ebuf + ei, 0);
        if (_path_ends_with_lower(path, &ebuf) == 1) { return 1; }
    }
    return 0;
}

# ── Public API ─────────────────────────────────────────────────────────

# Look up language by name. Returns index or -1.
fn lang_index(name) {
    var i = 0;
    while (i < LANG_COUNT) {
        if (streq(lang_name(i), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn lang_is_valid(name) {
    if (lang_index(name) >= 0) { return 1; }
    return 0;
}

# ── Config-driven extension overrides (1.1.1) ─────────────────────────
# Up to 16 user-defined `ext.<extension> = <language>` entries from
# config.cyml. Entries are registered before CLI parsing and consulted
# in detect_language_from_path BEFORE the built-in table — so a user
# can map .conf → shell without forking the bundled grammar list.

var USER_EXT_MAX = 16;
var g_user_ext_count = 0;
var g_user_ext_keys  = 0;   # alloc'd lazily: USER_EXT_MAX * 8 bytes
var g_user_ext_langs = 0;   # alloc'd lazily: USER_EXT_MAX * 8 bytes

fn _user_ext_init() {
    if (g_user_ext_keys == 0) {
        g_user_ext_keys  = alloc(USER_EXT_MAX * 8);
        g_user_ext_langs = alloc(USER_EXT_MAX * 8);
    }
    return 0;
}

# Register one ext→lang override. Returns 0 OK, 1 if table is full,
# 2 if the language name is unknown. Called by config.cyr after key
# parsing.
fn lang_register_ext_override(ext, lang) {
    if (g_user_ext_count >= USER_EXT_MAX) { return 1; }
    var li = lang_index(lang);
    if (li < 0) { return 2; }

    var elen = strlen(ext);
    if (elen == 0) { return 2; }

    _user_ext_init();

    # Normalize: prepend a leading dot if the user didn't include one,
    # so _path_ends_with_lower behaves the same as for the built-in
    # lang_exts table ("conf" → ".conf").
    var dot = 0;
    if (load8(ext) != 46) { dot = 1; }
    var copy = alloc(elen + dot + 1);
    var off = 0;
    if (dot == 1) {
        store8(copy + off, 46);
        off = off + 1;
    }
    var k = 0;
    while (k < elen) {
        store8(copy + off, load8(ext + k));
        off = off + 1;
        k = k + 1;
    }
    store8(copy + off, 0);

    store64(g_user_ext_keys  + g_user_ext_count * 8, copy);
    store64(g_user_ext_langs + g_user_ext_count * 8, li);
    g_user_ext_count = g_user_ext_count + 1;
    return 0;
}

# Map path → language name (by extension). Returns "plain" on no match.
# User config overrides win first; built-in table is the fallback.
fn detect_language_from_path(path) {
    var ui = 0;
    while (ui < g_user_ext_count) {
        var ext_ptr = load64(g_user_ext_keys + ui * 8);
        if (_path_ends_with_lower(path, ext_ptr) == 1) {
            var li = load64(g_user_ext_langs + ui * 8);
            return lang_name(li);
        }
        ui = ui + 1;
    }

    # Filename-shape detection (1.2.6) — Dockerfile and Makefile have
    # no extension. Case-sensitive per vyakarana ADRs: "Makefile",
    # "makefile", "GNUmakefile" all match makefile; "Dockerfile" and
    # "Containerfile" plus the .Dockerfile / .Containerfile suffix
    # forms match dockerfile.
    if (_path_filename_match(path, "Dockerfile") == 1)    { return "dockerfile"; }
    if (_path_filename_match(path, "Containerfile") == 1) { return "dockerfile"; }
    if (_path_filename_match(path, "Makefile") == 1)      { return "makefile"; }
    if (_path_filename_match(path, "makefile") == 1)      { return "makefile"; }
    if (_path_filename_match(path, "GNUmakefile") == 1)   { return "makefile"; }

    var i = 1;  # skip "plain"
    while (i < LANG_COUNT) {
        if (_path_has_any_ext(path, lang_exts(i)) == 1) {
            return lang_name(i);
        }
        i = i + 1;
    }
    return "plain";
}

# Scan a buffer holding the first N bytes of a file for a shebang line.
# Returns a language name or 0 if none matched.
fn detect_language_from_shebang(buf, n) {
    if (n < 3) { return 0; }
    if (load8(buf) != 35) { return 0; }   # '#'
    if (load8(buf + 1) != 33) { return 0; } # '!'

    # Extract shebang line (up to \n or EOF, cap at 127 bytes).
    var sb[128];
    var sbi = 0;
    var pi = 2;
    while (pi < n) {
        if (sbi >= 127) { break; }
        var c = load8(buf + pi);
        if (c == 10) { break; }
        store8(&sb + sbi, c);
        sbi = sbi + 1;
        pi = pi + 1;
    }
    store8(&sb + sbi, 0);

    # For each language with shebang hints, check if any hint appears
    # as a word in the shebang line. We check word-as-suffix-of-path
    # (e.g. "python" inside "/usr/bin/env python3" — the basename of
    # the last space-separated token) AND plain occurrence.
    var i = 1;
    while (i < LANG_COUNT) {
        var hints = lang_shebangs(i);
        if (strlen(hints) > 0) {
            # Tokenize hints
            var hlen = strlen(hints);
            var hi = 0;
            while (hi < hlen) {
                while (hi < hlen) {
                    if (load8(hints + hi) != 32) { break; }
                    hi = hi + 1;
                }
                if (hi >= hlen) { break; }
                var h_start = hi;
                while (hi < hlen) {
                    if (load8(hints + hi) == 32) { break; }
                    hi = hi + 1;
                }
                var h_len = hi - h_start;
                # Search sbuf for this hint as a whole token boundary.
                var sblen = sbi;
                var si = 0;
                while (si <= sblen - h_len) {
                    if (memeq(&sb + si, hints + h_start, h_len) == 1) {
                        # Boundary check: prev char must be / or space or start;
                        # next char must be end, space, digit, or newline.
                        var prev_ok = 0;
                        if (si == 0) { prev_ok = 1; }
                        else {
                            var pc = load8(&sb + si - 1);
                            if (pc == 47) { prev_ok = 1; }  # '/'
                            if (pc == 32) { prev_ok = 1; }  # ' '
                        }
                        var next_ok = 0;
                        if (si + h_len >= sblen) { next_ok = 1; }
                        else {
                            var nc = load8(&sb + si + h_len);
                            if (nc == 0)  { next_ok = 1; }
                            if (nc == 32) { next_ok = 1; }  # ' '
                            if (nc >= 48) { if (nc <= 57) { next_ok = 1; } } # digit (python3)
                        }
                        if (prev_ok == 1) {
                            if (next_ok == 1) { return lang_name(i); }
                        }
                    }
                    si = si + 1;
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

# Content-based detection (1.1.4). Conservative anchored patterns
# for file-format languages where the opening bytes are highly
# diagnostic. Programming languages are intentionally NOT detected
# this way — false-positive risk is too high for the small payoff.
# Returns a language name or 0 (no match).
#
# Recognized openings:
#   "{" / "[" non-alpha → json     (TOML section [name] disambiguates)
#   "---" at file start → yaml
#   "# " / "## "        → markdown
fn _is_alpha_or_underscore(c) {
    if (c == 95) { return 1; }              # _
    if (c >= 65) { if (c <= 90)  { return 1; } }
    if (c >= 97) { if (c <= 122) { return 1; } }
    return 0;
}

# Renamed at 1.3.1 — vyakarana 2.x exports its own
# `detect_language_from_content(src, src_len)` from
# dist/vyakarana.cyr and the duplicate triggered a "last definition
# wins" warning that the CI lint gate caught. owl's content
# detection (anchored `{`/`[`/`---`/`#` patterns from M1.4) stays
# under the `_owl_*` convention used elsewhere in owl
# (`_owl_load_grammar`, `_owl_bootstrap_grammars`).
fn _owl_detect_language_from_content(buf, n) {
    if (n == 0) { return 0; }
    # Skip leading blank lines + whitespace.
    var i = 0;
    while (i < n) {
        var c = load8(buf + i);
        if (c != 32) {
            if (c != 9) {
                if (c != 10) {
                    if (c != 13) { break; }
                }
            }
        }
        i = i + 1;
    }
    if (i >= n) { return 0; }

    var c0 = load8(buf + i);

    # JSON: first non-whitespace is "{" — high confidence.
    if (c0 == 123) { return "json"; }   # {

    # "[" is JSON array OR TOML section. Peek next non-space char.
    if (c0 == 91) {                     # [
        if (i + 1 < n) {
            var c1 = load8(buf + i + 1);
            if (_is_alpha_or_underscore(c1) == 1) { return "toml"; }
        }
        return "json";
    }

    # YAML: "---" at start of first non-blank line (document separator).
    if (c0 == 45) {                     # -
        if (i + 2 < n) {
            if (load8(buf + i + 1) == 45) {
                if (load8(buf + i + 2) == 45) {
                    return "yaml";
                }
            }
        }
    }

    # Markdown: ATX header "# " or "## ..."
    if (c0 == 35) {                     # #
        if (i + 1 < n) {
            var c1 = load8(buf + i + 1);
            if (c1 == 32) { return "markdown"; }
            if (c1 == 35) { return "markdown"; }
        }
    }

    return 0;
}

fn print_language_list() {
    var i = 0;
    while (i < LANG_COUNT) {
        println(lang_name(i));
        i = i + 1;
    }
    return 0;
}
