# src/pager.cyr — pager spawn + cleanup (M4)
#
# Pipeline:
#   parent: pipe() → fork() → child: dup2 read→fd0, exec sh -c "$PAGER"
#           parent: dup2 write→fd1, render to stdout (= pipe), close fd1,
#           waitpid
#
# Pager resolution cascade: OWL_PAGER → PAGER → "less -RFX". -R passes
# ANSI, -F quits if content fits one screen (avoids paging short files —
# we always spawn the pager and let less decide), -X leaves content on
# screen after quit. sh -c handles flag-carrying env var values.

# ── State ──────────────────────────────────────────────────────────────
var g_flag_paging   = 0 - 1;   # -1 auto, 0 never, 1 always
var g_pager_pid     = 0;       # 0 when not started
var g_pager_orig_out = 0;      # 0 when not saved; else fd of dup'd stdout

# ── Pager command resolution ───────────────────────────────────────────

fn resolve_pager_cmd() {
    var owl_p = getenv("OWL_PAGER");
    if (owl_p != 0) { if (load8(owl_p) != 0) { return owl_p; } }
    var pager = getenv("PAGER");
    if (pager != 0) { if (load8(pager) != 0) { return pager; } }
    return "less -RFX";
}

# (The gate — should_page() — lives in main.cyr so it can see is_tty
# and g_flag_plain without pager.cyr reaching across includes.)

# ── Start / stop ──────────────────────────────────────────────────────

# Fork + exec pager, dup2 the pipe's write-end onto stdout in the parent.
# Returns pager pid on success, 0 on failure (caller proceeds without
# paging — silent fallback; the first render syscall just writes to the
# original TTY in that case).
fn start_pager() {
    #ifdef CYRIUS_TARGET_AGNOS
    # agnos has no fork/execve — there is no external pager to spawn. Returning
    # 0 takes the caller's "no paging" path, which writes straight to stdout (the
    # fb console scrolls; there is no `less`).
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var cmd = resolve_pager_cmd();

    var pipefd[16];
    var pr = sys_pipe(&pipefd);
    if (pr < 0) { return 0; }
    var read_fd  = load32(&pipefd);
    var write_fd = load32(&pipefd + 4);

    var pid = sys_fork();
    if (pid < 0) {
        sys_close(read_fd);
        sys_close(write_fd);
        return 0;
    }

    if (pid == 0) {
        # Child: wire the pipe's read end to stdin, then exec the pager with
        # owl's full environment (_pager_envp). PATH alone is not enough:
        # less needs TERM (terminfo init), HOME (~/.lesshst), LANG/LC_*
        # (UTF-8), LESS (flags), COLORTERM. Without TERM it prints
        # "'unknown': I need something more specific." and exits, leaving
        # owl writing into a dead pipe. PAGER values still flow through
        # `/bin/sh -c` exactly as before (INFO-001), and no file-derived
        # string ever reaches that command.
        sys_close(write_fd);
        # If owl started with fd 0 closed, pipe() handed us 0 as the read
        # end: it is already the pager's stdin, and dup2(0, 0) + close(0)
        # would close it (audit 2026-10-31: the pager got no input).
        if (read_fd != 0) {
            sys_dup2(read_fd, 0);
            sys_close(read_fd);
        }
        var argv[64];
        store64(&argv + 0,  "/bin/sh");
        store64(&argv + 8,  "-c");
        store64(&argv + 16, cmd);
        store64(&argv + 24, 0);
        sys_execve("/bin/sh", &argv, _pager_envp());
        sys_exit(127);
    }

    # Parent: keep a dup of the real stdout in case we want to restore
    # it for error reporting, then route fd 1 into the pipe.
    g_pager_orig_out = syscall(SYS_DUP, 1);
    sys_close(read_fd);
    sys_dup2(write_fd, 1);
    sys_close(write_fd);
    g_pager_pid = pid;
    # While the pager owns the terminal, Ctrl-C is the pager's (less keeps
    # running on ^C). owl ignores it and ends when the pager closes the
    # pipe; dying here left the pager orphaned on the TTY with PPID 1
    # (audit 2026-10-31). Set after fork, so the pager keeps the default.
    signal_ignore(SIGINT);
    return pid;
    #endif
}

# The pager's environment: owl's own, whole. Built from the stdlib's
# env_block (the block getenv reads, sized to the real environment), so
# nothing past 16 KB or past 255 entries is dropped — through 1.5.2 a large
# environment lost TERM / PATH / LANG and less ran degraded (audit
# 2026-10-31; FINDING-009's unterminated-entry guard is moot here, since
# env_block's entries are all terminated). `LESS=FRX` is added when LESS is
# unset, as git does, so a bare `PAGER=less` renders colour and does not
# page a short file. Called in the forked child only.
fn _pager_envp() {
    var blen = 0;
    var blk = env_block(&blen);
    var count = 0;
    var i = 0;
    while (i < blen) {
        if (load8(blk + i) == 0) { count = count + 1; }
        i = i + 1;
    }
    var envp = alloc((count + 3) * 8);
    if (envp == 0) { return 0; }
    var slot = 0;
    var has_less = 0;
    var start = 0;
    i = 0;
    while (i < blen) {
        if (load8(blk + i) == 0) {
            if (i > start) {
                store64(envp + slot * 8, blk + start);
                slot = slot + 1;
                if (i - start >= 5) {
                    if (memeq(blk + start, "LESS=", 5) == 1) { has_less = 1; }
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    if (slot == 0) {
        store64(envp, "PATH=/usr/local/bin:/usr/bin:/bin");
        slot = 1;
    }
    if (has_less == 0) {
        store64(envp + slot * 8, "LESS=FRX");
        slot = slot + 1;
    }
    store64(envp + slot * 8, 0);
    return envp;
}

# Close our write-end of the pipe (fd 1) so the pager gets EOF, then
# wait for it. Restores the original stdout fd so any late error
# reporting from main still reaches the terminal (not the now-dead
# pipe).
fn stop_pager() {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (g_pager_pid == 0) { return 0; }
    out_flush();
    sys_close(1);
    if (g_pager_orig_out > 0) {
        sys_dup2(g_pager_orig_out, 1);
        sys_close(g_pager_orig_out);
        g_pager_orig_out = 0;
    }
    # status_buf is 8 bytes: sys_waitpid writes a kernel int (4 bytes)
    # into this pointer. Declaring [1] per the old convention wrote 3
    # bytes past the slot — see docs/audit/2026-04-23-audit.md
    # FINDING-004.
    var status_buf[8];
    sys_waitpid(g_pager_pid, &status_buf, 0);
    g_pager_pid = 0;
    signal_default(SIGINT);
    return 0;
    #endif
}

# Called during arg parse. Parses --paging=<value>; returns 0 OK,
# 1 on bad value.
fn set_paging(value) {
    if (streq(value, "auto") == 1)   { g_flag_paging = 0 - 1; return 0; }
    if (streq(value, "always") == 1) { g_flag_paging = 1;     return 0; }
    if (streq(value, "never") == 1)  { g_flag_paging = 0;     return 0; }
    return 1;
}
