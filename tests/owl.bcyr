# owl benchmarks
# Stdlib auto-included via cyrius.cyml. `bench` and `fnptr` come from its
# [test] scope (1.6.0), which `cyrius bench` prepends and the shipped `owl`
# never sees; through 1.5.3 they were kept out of [deps].stdlib and included
# only here. The includes stay so an editor resolving this file in build
# scope sees them (include-once: one copy either way). The paths resolve
# from the project root (where lib/ is vendored), not from tests/.
include "lib/fnptr.cyr"
include "lib/bench.cyr"

fn bench_noop() { return 0; }

fn main() {
    alloc_init();
    var b = bench_new("noop");
    bench_run(b, &bench_noop, 1000000);
    bench_report(b);
    return 0;
}

var r = main();
syscall(60, r);
